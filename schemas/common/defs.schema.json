{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qaos.local/schemas/common/defs.schema.json",
  "title": "QAOS Common Definitions",
  "$defs": {
    "SpecId": {
      "type": "string",
      "pattern": "^SPEC-[A-Z0-9]+-[0-9]{3,}$"
    },
    "SpecVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$"
    },
    "RequirementId": {
      "type": "string",
      "pattern": "^REQ-[A-Z0-9]+-[0-9]{3,}$"
    },
    "AcId": {
      "type": "string",
      "pattern": "^AC-[A-Z0-9]+-[0-9]{3,}$"
    },
    "TestCaseId": {
      "type": "string",
      "pattern": "^TC-[A-Z0-9]+-[0-9]{3,}$"
    },
    "FunctionalArea": {
      "type": "string",
      "pattern": "^[A-Z0-9]+$",
      "description": "與 spec.schema 的 functional_area、TestCaseId 的 area 段一致"
    },
    "TestCaseDraftId": {
      "type": "string",
      "pattern": "^TC-DRAFT-[0-9A-Z]{26}$"
    },
    "SuiteId": {
      "type": "string",
      "pattern": "^SUITE-(FULL|CI|HOTFIX|SMOKE|FEATURE)(-[A-Z0-9]+)?$"
    },
    "ExecutionId": {
      "type": "string",
      "pattern": "^EXE-[0-9]{8}-[0-9]{3,}$"
    },
    "EvidenceId": {
      "type": "string",
      "pattern": "^EVD-[0-9]{4,}$"
    },
    "BugId": {
      "type": "string",
      "pattern": "^BUG-[A-Z0-9]+-[0-9]{3,}$"
    },
    "ChangeImpactId": {
      "type": "string",
      "pattern": "^CI-SPEC-[A-Z0-9]+-[0-9]{3,}-[0-9.]+-[0-9.]+$"
    },
    "ArtifactId": {
      "type": "string",
      "pattern": "^ART-[A-Z]+-[0-9A-Z]{26}$"
    },
    "RunId": {
      "type": "string",
      "pattern": "^RUN-[0-9]{8}-[0-9]{3,}$"
    },
    "TaskId": {
      "type": "string",
      "pattern": "^T[0-9]+[A-Z]{0,2}$"
    },
    "ApprovalId": {
      "type": "string",
      "pattern": "^APR-[0-9]{4,}$"
    },
    "AgentId": {
      "type": "string",
      "pattern": "^agent-[a-z-]+$"
    },
    "HumanId": {
      "type": "string",
      "minLength": 1,
      "description": "email 或帳號；不得為 agent-*"
    },
    "ActionId": {
      "type": "string",
      "pattern": "^[A-Z_]+$"
    },
    "Sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "Timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "IntVersion": {
      "type": "integer",
      "minimum": 1
    },
    "TestLevel": {
      "type": "string",
      "enum": [
        "unit",
        "component",
        "integration",
        "api",
        "ui_e2e"
      ]
    },
    "TestType": {
      "type": "string",
      "enum": [
        "functional",
        "negative",
        "boundary",
        "security",
        "performance",
        "usability",
        "compatibility"
      ]
    },
    "ExecutionMode": {
      "type": "string",
      "enum": [
        "manual",
        "automated",
        "hybrid"
      ]
    },
    "AutomationStatus": {
      "type": "string",
      "enum": [
        "not_automated",
        "planned",
        "automated"
      ]
    },
    "Priority": {
      "type": "string",
      "enum": [
        "critical",
        "high",
        "medium",
        "low"
      ]
    },
    "Risk": {
      "type": "string",
      "enum": [
        "high",
        "medium",
        "low"
      ]
    },
    "Severity": {
      "type": "string",
      "enum": [
        "blocker",
        "critical",
        "major",
        "minor",
        "trivial"
      ]
    },
    "ExecutionCost": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "Stability": {
      "type": "string",
      "enum": [
        "unknown",
        "stable",
        "flaky"
      ]
    },
    "SuiteType": {
      "type": "string",
      "enum": [
        "full_regression",
        "ci_regression",
        "hotfix",
        "smoke",
        "feature"
      ]
    },
    "DesignTechnique": {
      "type": "string",
      "enum": [
        "requirement_based",
        "boundary_value",
        "equivalence_partitioning",
        "decision_table",
        "state_transition",
        "scenario",
        "negative",
        "error_guessing",
        "pairwise",
        "security_rule"
      ]
    },
    "TestCaseSource": {
      "type": "string",
      "enum": [
        "spec_workflow",
        "change_workflow",
        "manual_integration",
        "import"
      ]
    },
    "AmbiguityLevel": {
      "type": "string",
      "enum": [
        "critical",
        "major",
        "minor"
      ]
    },
    "IssueSeverity": {
      "type": "string",
      "enum": [
        "blocker",
        "major",
        "minor"
      ]
    },
    "ValidationResult": {
      "type": "string",
      "enum": [
        "PASS",
        "FAIL"
      ]
    },
    "BugValidationResult": {
      "type": "string",
      "enum": [
        "PASS",
        "FAIL",
        "DUPLICATE",
        "AMBIGUITY"
      ]
    },
    "TestCaseStatus": {
      "type": "string",
      "enum": [
        "DRAFT",
        "VALIDATING",
        "VALIDATION_FAILED",
        "VALIDATED",
        "PENDING_APPROVAL",
        "APPROVED",
        "ACTIVE",
        "SUPERSEDED",
        "RETIRED"
      ]
    },
    "BugStatus": {
      "type": "string",
      "enum": [
        "DRAFT",
        "VALIDATING",
        "VALIDATION_FAILED",
        "AMBIGUITY_ESCALATED",
        "VALIDATED",
        "PENDING_APPROVAL",
        "OPEN",
        "IN_PROGRESS",
        "RESOLVED",
        "VERIFIED",
        "CLOSED",
        "REJECTED"
      ]
    },
    "ChangeImpactStatus": {
      "type": "string",
      "enum": [
        "DETECTED",
        "ANALYZING",
        "NO_IMPACT",
        "IMPACTED",
        "TEST_UPDATE_REQUIRED",
        "VALIDATING",
        "COMPARING",
        "PENDING_APPROVAL",
        "APPLIED"
      ]
    },
    "RequirementStatus": {
      "type": "string",
      "enum": [
        "DRAFT",
        "ACTIVE",
        "CHANGED",
        "RETIRED"
      ]
    },
    "SuiteStatus": {
      "type": "string",
      "enum": [
        "DRAFT",
        "PENDING_APPROVAL",
        "ACTIVE",
        "RETIRED"
      ]
    },
    "ArtifactStatus": {
      "type": "string",
      "enum": [
        "DRAFT",
        "SUBMITTED",
        "VALID",
        "INVALID",
        "SUPERSEDED"
      ]
    },
    "RunStatus": {
      "type": "string",
      "enum": [
        "CREATED",
        "RUNNING",
        "WAITING_HUMAN",
        "COMPLETED",
        "FAILED",
        "CANCELLED"
      ]
    },
    "TaskStatus": {
      "type": "string",
      "enum": [
        "PENDING",
        "READY",
        "RUNNING",
        "ARTIFACT_INVALID",
        "GATE_FAILED",
        "DONE",
        "FAILED"
      ]
    },
    "ApprovalType": {
      "type": "string",
      "enum": [
        "ACTIVATE_TESTCASE",
        "REVIEW_TEST_ANALYSIS",
        "APPLY_CHANGE",
        "RETIRE_TESTCASE",
        "OPEN_BUG",
        "CLOSE_BUG",
        "CHANGE_BUG_SEVERITY",
        "CONFIRM_DUPLICATE",
        "UPDATE_SUITE_MEMBERSHIP",
        "RESOLVE_AMBIGUITY",
        "HUMAN_OVERRIDE",
        "NEEDS_DECISION"
      ]
    },
    "ApprovalStatus": {
      "type": "string",
      "enum": [
        "PENDING",
        "DECIDED",
        "EXPIRED",
        "CANCELLED"
      ]
    },
    "Decision": {
      "type": "string",
      "enum": [
        "approve",
        "reject",
        "override"
      ]
    },
    "GateId": {
      "type": "string",
      "enum": [
        "G-SPEC",
        "G-DESIGN",
        "G-TVAL",
        "G-BVAL",
        "G-IMPACT",
        "G-COMPARE",
        "G-REG",
        "G-APPROVAL",
        "G-RISK"
      ]
    },
    "SpecReference": {
      "type": "object",
      "required": [
        "spec_id",
        "spec_version",
        "location"
      ],
      "properties": {
        "spec_id": {
          "$ref": "#/$defs/SpecId"
        },
        "spec_version": {
          "$ref": "#/$defs/SpecVersion"
        },
        "location": {
          "type": "string",
          "description": "章節 / 標題 / 行號範圍，例如 '§3.2 L120-L134'"
        },
        "quote": {
          "type": "string",
          "description": "原文引用（≤ 300 字）",
          "maxLength": 300
        }
      },
      "additionalProperties": false
    },
    "EntityRef": {
      "type": "object",
      "required": [
        "entity_type",
        "id"
      ],
      "properties": {
        "entity_type": {
          "type": "string",
          "enum": [
            "Spec",
            "SpecVersion",
            "Requirement",
            "AcceptanceCriterion",
            "TestCase",
            "TestCaseVersion",
            "TestSuite",
            "TestExecution",
            "Evidence",
            "Bug",
            "ChangeImpact",
            "Artifact",
            "WorkflowRun",
            "ApprovalRequest",
            "ManualTestRecord",
            "Clarification"
          ]
        },
        "id": {
          "type": "string"
        },
        "version": {
          "type": [
            "string",
            "integer"
          ]
        }
      },
      "additionalProperties": false
    },
    "HistoryEntry": {
      "type": "object",
      "required": [
        "at",
        "from_status",
        "to_status",
        "by",
        "trigger"
      ],
      "properties": {
        "at": {
          "$ref": "#/$defs/Timestamp"
        },
        "from_status": {
          "type": [
            "string",
            "null"
          ]
        },
        "to_status": {
          "type": "string"
        },
        "by": {
          "type": "string",
          "description": "agent_id | human_id | system"
        },
        "trigger": {
          "type": "string",
          "description": "artifact_id | approval_id | action_id"
        },
        "run_id": {
          "$ref": "#/$defs/RunId"
        },
        "note": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "Ambiguity": {
      "type": "object",
      "required": [
        "level",
        "description"
      ],
      "properties": {
        "level": {
          "$ref": "#/$defs/DPLevel",
          "description": "新資料（有 decision_points）＝所有決策點 effective_level 的最大值（由推導決定）；舊資料沒有 none"
        },
        "description": {
          "type": "string"
        },
        "options": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "可能的解讀，供 Human RESOLVE_AMBIGUITY"
        },
        "resolved_by_approval": {
          "$ref": "#/$defs/ApprovalId"
        },
        "raised_level": {
          "$ref": "#/$defs/DPLevel",
          "description": "新資料：所有決策點原始 level 的最大值（由推導決定，X9）"
        }
      },
      "additionalProperties": false
    },
    "ValidationIssue": {
      "type": "object",
      "description": "Brief §7.4 八個必填欄位",
      "required": [
        "testcase_id",
        "issue_type",
        "severity",
        "violated_requirement",
        "spec_reference",
        "evidence",
        "explanation",
        "recommended_change"
      ],
      "properties": {
        "testcase_id": {
          "type": "string"
        },
        "issue_type": {
          "type": "string",
          "enum": [
            "spec_mismatch",
            "requirement_mismatch",
            "unsupported_assumption",
            "invalid_expected_result",
            "non_executable_steps",
            "missing_coverage",
            "missing_traceability",
            "duplicate",
            "unreasonable_edge_case",
            "critical_ambiguity",
            "missing_reference",
            "missing_negative_coverage",
            "technique_mismatch",
            "other"
          ]
        },
        "severity": {
          "$ref": "#/$defs/IssueSeverity"
        },
        "violated_requirement": {
          "type": [
            "string",
            "null"
          ],
          "description": "requirement_id 或 null（若為結構問題）"
        },
        "spec_reference": {
          "anyOf": [
            {
              "$ref": "#/$defs/SpecReference"
            },
            {
              "type": "null"
            }
          ]
        },
        "evidence": {
          "type": "string",
          "description": "驗證者引用的 Draft 內容 / Spec 原文對照"
        },
        "explanation": {
          "type": "string"
        },
        "recommended_change": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "ClarificationId": {
      "type": "string",
      "pattern": "^CLR-[A-Z0-9]+-[0-9]{3,}$"
    },
    "ClarificationStatus": {
      "type": "string",
      "enum": [
        "OPEN",
        "ASKED",
        "ANSWERED",
        "APPLIED",
        "WITHDRAWN"
      ]
    },
    "SpecPin": {
      "type": "object",
      "description": "spec 版本的身分：content_hash 必須同時等於 spec.yaml 登記值與實體檔 sha256（需求 A 第 2 章）",
      "required": [
        "spec_id",
        "spec_version",
        "content_hash"
      ],
      "properties": {
        "spec_id": {
          "$ref": "#/$defs/SpecId"
        },
        "spec_version": {
          "$ref": "#/$defs/SpecVersion"
        },
        "content_hash": {
          "$ref": "#/$defs/Sha256"
        }
      },
      "additionalProperties": false
    },
    "ReferenceRole": {
      "type": "string",
      "enum": [
        "normative",
        "informative"
      ]
    },
    "SpecReferenceDecl": {
      "type": "object",
      "description": "直接層引用（附錄 A 2-5）：SpecPin＋role＋scope；decl_rev、depth 只在閉包展開時計算",
      "required": [
        "spec_id",
        "spec_version",
        "content_hash",
        "role"
      ],
      "properties": {
        "spec_id": {
          "$ref": "#/$defs/SpecId"
        },
        "spec_version": {
          "$ref": "#/$defs/SpecVersion"
        },
        "content_hash": {
          "$ref": "#/$defs/Sha256"
        },
        "role": {
          "$ref": "#/$defs/ReferenceRole"
        },
        "scope": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "RefNode": {
      "type": "object",
      "description": "引用閉包中的一個節點：SpecPin＋decl_rev＋role＋depth",
      "required": [
        "spec_id",
        "spec_version",
        "content_hash",
        "decl_rev",
        "role",
        "depth"
      ],
      "properties": {
        "spec_id": {
          "$ref": "#/$defs/SpecId"
        },
        "spec_version": {
          "$ref": "#/$defs/SpecVersion"
        },
        "content_hash": {
          "$ref": "#/$defs/Sha256"
        },
        "decl_rev": {
          "type": "integer",
          "minimum": 0
        },
        "role": {
          "$ref": "#/$defs/ReferenceRole"
        },
        "depth": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "Topic": {
      "type": "string",
      "enum": [
        "rejection_response",
        "error_code",
        "permission",
        "boundary_value",
        "state_transition",
        "display_format",
        "calculation",
        "data_scope",
        "other"
      ],
      "description": "受控分類（需求 A 附錄 A 1-3）；之後以修改 schema 的方式增減"
    },
    "Subject": {
      "type": "string",
      "pattern": "^[a-z0-9_]+(\\.[a-z0-9_]+)*$",
      "description": "受描述物件與面向的路徑字串"
    },
    "RoleScope": {
      "description": "角色清單，或 [\"*\"] 代表與角色無關；必須明示，空陣列不合法（X18）；* 不得和具名角色混用（附錄 A 1-8）",
      "oneOf": [
        {
          "type": "array",
          "const": [
            "*"
          ]
        },
        {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$"
          }
        }
      ]
    },
    "QuestionParams": {
      "type": "object",
      "description": "鍵和值只允許 [a-z0-9_]，值可以是陣列；{} 代表沒有參數限制",
      "propertyNames": {
        "pattern": "^[a-z0-9_]+$"
      },
      "additionalProperties": {
        "oneOf": [
          {
            "type": "string",
            "pattern": "^[a-z0-9_]+$"
          },
          {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9_]+$"
            }
          }
        ]
      }
    },
    "QuestionScope": {
      "type": "object",
      "required": [
        "spec_id",
        "requirement_id",
        "subject",
        "role_scope",
        "params"
      ],
      "properties": {
        "spec_id": {
          "$ref": "#/$defs/SpecId"
        },
        "requirement_id": {
          "$ref": "#/$defs/RequirementId"
        },
        "subject": {
          "$ref": "#/$defs/Subject"
        },
        "role_scope": {
          "$ref": "#/$defs/RoleScope"
        },
        "params": {
          "$ref": "#/$defs/QuestionParams"
        }
      },
      "additionalProperties": false
    },
    "Basis": {
      "type": "object",
      "description": "一次分析或一次回答所依據的文件集合；closure 只取 normative 遞移閉包（附錄 A 1-1）",
      "required": [
        "target",
        "target_decl_rev",
        "closure"
      ],
      "properties": {
        "target": {
          "$ref": "#/$defs/SpecPin"
        },
        "target_decl_rev": {
          "type": "integer",
          "minimum": 0
        },
        "closure": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "spec_id",
              "spec_version",
              "content_hash",
              "decl_rev"
            ],
            "properties": {
              "spec_id": {
                "$ref": "#/$defs/SpecId"
              },
              "spec_version": {
                "$ref": "#/$defs/SpecVersion"
              },
              "content_hash": {
                "$ref": "#/$defs/Sha256"
              },
              "decl_rev": {
                "type": "integer",
                "minimum": 0
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "SourceRef": {
      "description": "有型別的依據引用（需求 A 第 3 章 §6）：spec、clarification、approval 三型，都帶非空的 quote",
      "oneOf": [
        {
          "type": "object",
          "required": [
            "type",
            "spec_id",
            "spec_version",
            "content_hash",
            "location",
            "quote"
          ],
          "properties": {
            "type": {
              "const": "spec"
            },
            "spec_id": {
              "$ref": "#/$defs/SpecId"
            },
            "spec_version": {
              "$ref": "#/$defs/SpecVersion"
            },
            "content_hash": {
              "$ref": "#/$defs/Sha256"
            },
            "location": {
              "type": "string",
              "minLength": 1
            },
            "quote": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "type",
            "clarification_id",
            "answer_rev",
            "answer_sha256",
            "quote"
          ],
          "properties": {
            "type": {
              "const": "clarification"
            },
            "clarification_id": {
              "$ref": "#/$defs/ClarificationId"
            },
            "answer_rev": {
              "type": "integer",
              "minimum": 0
            },
            "answer_sha256": {
              "$ref": "#/$defs/Sha256"
            },
            "quote": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "type",
            "approval_id",
            "decision_sha256",
            "resolution_index",
            "quote"
          ],
          "properties": {
            "type": {
              "const": "approval"
            },
            "approval_id": {
              "$ref": "#/$defs/ApprovalId"
            },
            "decision_sha256": {
              "$ref": "#/$defs/Sha256"
            },
            "resolution_index": {
              "type": "integer",
              "minimum": 0
            },
            "quote": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "RMPin": {
      "type": "object",
      "description": "指向一份 RM revision 的釘選（需求 A 第 5 章）；sha256 是 revision 檔的 sha256",
      "required": [
        "spec_id",
        "spec_version",
        "revision",
        "sha256"
      ],
      "properties": {
        "spec_id": {
          "$ref": "#/$defs/SpecId"
        },
        "spec_version": {
          "$ref": "#/$defs/SpecVersion"
        },
        "revision": {
          "type": "string",
          "pattern": "^R[0-9]{3,}$"
        },
        "sha256": {
          "$ref": "#/$defs/Sha256"
        }
      },
      "additionalProperties": false
    },
    "DPLevel": {
      "type": "string",
      "enum": [
        "none",
        "minor",
        "major",
        "critical"
      ],
      "description": "決策點的原始等級與有效等級（需求 A 第 1 章 §3.1）"
    },
    "CitedAt": {
      "type": "object",
      "description": "缺檔的引用處：SpecPin＋行號＋命中文字",
      "required": [
        "spec_id",
        "spec_version",
        "content_hash",
        "line",
        "text"
      ],
      "properties": {
        "spec_id": {
          "$ref": "#/$defs/SpecId"
        },
        "spec_version": {
          "$ref": "#/$defs/SpecVersion"
        },
        "content_hash": {
          "$ref": "#/$defs/Sha256"
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "text": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "MissingSource": {
      "type": "object",
      "required": [
        "cited_at",
        "name"
      ],
      "description": "被引用、但沒取得的文件：只需要引用處，不需要缺檔本身的 hash",
      "properties": {
        "cited_at": {
          "$ref": "#/$defs/CitedAt"
        },
        "name": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "UnconsultedRef": {
      "type": "object",
      "required": [
        "pin",
        "reason"
      ],
      "description": "派發包中 depth=1 的 normative 參考沒有查閱（X5、X17）",
      "properties": {
        "pin": {
          "$ref": "#/$defs/SpecPin"
        },
        "reason": {
          "type": "string",
          "enum": [
            "unavailable",
            "out_of_scope"
          ]
        },
        "note": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "WaivedItem": {
      "description": "被豁免的一項：缺檔（cited_at 的 SpecPin＋line，加上 name）或未查參考（pin）",
      "oneOf": [
        {
          "type": "object",
          "required": [
            "cited_at",
            "name"
          ],
          "properties": {
            "cited_at": {
              "type": "object",
              "required": [
                "spec_id",
                "spec_version",
                "content_hash",
                "line"
              ],
              "properties": {
                "spec_id": {
                  "$ref": "#/$defs/SpecId"
                },
                "spec_version": {
                  "$ref": "#/$defs/SpecVersion"
                },
                "content_hash": {
                  "$ref": "#/$defs/Sha256"
                },
                "line": {
                  "type": "integer",
                  "minimum": 1
                },
                "text": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            },
            "name": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "pin"
          ],
          "properties": {
            "pin": {
              "$ref": "#/$defs/SpecPin"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "Waiver": {
      "type": "object",
      "required": [
        "approval_id",
        "decision_sha256",
        "resolution_index",
        "waived"
      ],
      "properties": {
        "approval_id": {
          "$ref": "#/$defs/ApprovalId"
        },
        "decision_sha256": {
          "$ref": "#/$defs/Sha256"
        },
        "resolution_index": {
          "type": "integer",
          "minimum": 0
        },
        "waived": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/WaivedItem"
          }
        }
      },
      "additionalProperties": false
    },
    "Coverage": {
      "type": "object",
      "required": [
        "references_status",
        "consulted",
        "unconsulted_normative",
        "missing_sources",
        "waivers"
      ],
      "properties": {
        "references_status": {
          "type": "string",
          "enum": [
            "undeclared",
            "declared_empty",
            "declared"
          ]
        },
        "consulted": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SpecPin"
          }
        },
        "unconsulted_normative": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/UnconsultedRef"
          }
        },
        "missing_sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/MissingSource"
          }
        },
        "waivers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Waiver"
          }
        }
      },
      "additionalProperties": false
    },
    "DPResolution": {
      "type": "object",
      "description": "裁決；完整性由 G-SPEC 檢查（X11、X13）",
      "properties": {
        "source": {
          "$ref": "#/$defs/SourceRef"
        },
        "decided_at": {
          "type": "string",
          "minLength": 1
        },
        "adopted_side_index": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "integer",
              "minimum": 0
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "DecisionPoint": {
      "type": "object",
      "description": "需求底下的一個待決或已決事項（需求 A 第 1 章 §2.5、§3.1）。basis_hash、derived 由 runtime 寫入，agent 的產出不得帶（附錄 A 1-11）",
      "required": [
        "question_id",
        "topic",
        "subject",
        "role_scope",
        "params",
        "level",
        "basis",
        "known_rules",
        "coverage"
      ],
      "properties": {
        "question_id": {
          "type": "string",
          "pattern": "^Q[0-9]{2,}$"
        },
        "topic": {
          "$ref": "#/$defs/Topic"
        },
        "subject": {
          "$ref": "#/$defs/Subject"
        },
        "role_scope": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^([a-z0-9_]+|\\*)$"
          },
          "uniqueItems": true,
          "description": "必須明示；空陣列由 G-SPEC 以 X18 拒絕"
        },
        "params": {
          "$ref": "#/$defs/QuestionParams"
        },
        "level": {
          "$ref": "#/$defs/DPLevel"
        },
        "basis": {
          "type": "string",
          "enum": [
            "defined_in_target",
            "defined_in_reference",
            "defined_by_decision",
            "undefined",
            "conflict"
          ]
        },
        "known_rules": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SourceRef"
          }
        },
        "conflict_sides": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SourceRef"
          }
        },
        "conflict_note": {
          "type": "string"
        },
        "resolution": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/DPResolution"
            }
          ]
        },
        "coverage": {
          "$ref": "#/$defs/Coverage"
        },
        "decision_needed": {
          "type": "string"
        },
        "detail_gaps": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "prior_clarifications": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ClarificationId"
          }
        },
        "basis_hash": {
          "$ref": "#/$defs/Sha256"
        },
        "derived": {
          "type": "object",
          "description": "runtime 推導（第 1 章 §3.2～§3.5）",
          "required": [
            "state",
            "effective_level",
            "route",
            "resolved",
            "gap_missing",
            "gap_unverified"
          ],
          "properties": {
            "state": {
              "type": "string",
              "enum": [
                "E1",
                "E2",
                "E3",
                "E4",
                "E5"
              ]
            },
            "effective_level": {
              "$ref": "#/$defs/DPLevel"
            },
            "route": {
              "type": "string",
              "pattern": "^R[1-9]$"
            },
            "resolved": {
              "type": "boolean"
            },
            "gap_missing": {
              "type": "boolean"
            },
            "gap_unverified": {
              "type": "boolean"
            },
            "resolved_conflict": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "DocIssue": {
      "type": "object",
      "required": [
        "kind",
        "location",
        "note",
        "status"
      ],
      "description": "文件本身的問題；不影響需求狀態，也不自動開單（附錄 A 1-5）",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "wording_conflict",
            "missing_definition",
            "inconsistent_reference",
            "typo"
          ]
        },
        "location": {
          "type": "object",
          "required": [
            "spec_id",
            "spec_version",
            "content_hash",
            "line"
          ],
          "properties": {
            "spec_id": {
              "$ref": "#/$defs/SpecId"
            },
            "spec_version": {
              "$ref": "#/$defs/SpecVersion"
            },
            "content_hash": {
              "$ref": "#/$defs/Sha256"
            },
            "line": {
              "type": "integer",
              "minimum": 1
            }
          },
          "additionalProperties": false
        },
        "note": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "enum": [
            "open",
            "pending_owner_decision",
            "resolved"
          ]
        }
      },
      "additionalProperties": false
    },
    "BasisRef": {
      "description": "SourceRef 的身分（不含 quote；第 1 章名詞表）",
      "oneOf": [
        {
          "type": "object",
          "required": [
            "type",
            "spec_id",
            "spec_version",
            "content_hash",
            "location"
          ],
          "properties": {
            "type": {
              "const": "spec"
            },
            "spec_id": {
              "$ref": "#/$defs/SpecId"
            },
            "spec_version": {
              "$ref": "#/$defs/SpecVersion"
            },
            "content_hash": {
              "$ref": "#/$defs/Sha256"
            },
            "location": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "type",
            "clarification_id",
            "answer_rev",
            "answer_sha256"
          ],
          "properties": {
            "type": {
              "const": "clarification"
            },
            "clarification_id": {
              "$ref": "#/$defs/ClarificationId"
            },
            "answer_rev": {
              "type": "integer",
              "minimum": 0
            },
            "answer_sha256": {
              "$ref": "#/$defs/Sha256"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "type",
            "approval_id",
            "resolution_index",
            "decision_sha256"
          ],
          "properties": {
            "type": {
              "const": "approval"
            },
            "approval_id": {
              "$ref": "#/$defs/ApprovalId"
            },
            "resolution_index": {
              "type": "integer",
              "minimum": 0
            },
            "decision_sha256": {
              "$ref": "#/$defs/Sha256"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "DecisionRef": {
      "type": "object",
      "required": [
        "requirement_id",
        "question_id",
        "basis_ref"
      ],
      "description": "TC 斷言依賴的決策點；basis_ref 為該斷言所用依據的身分，exploratory 斷言沒有依據時為 null",
      "properties": {
        "requirement_id": {
          "$ref": "#/$defs/RequirementId"
        },
        "question_id": {
          "type": "string",
          "pattern": "^Q[0-9]{2,}$"
        },
        "basis_ref": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/BasisRef"
            }
          ]
        }
      },
      "additionalProperties": false
    }
  }
}

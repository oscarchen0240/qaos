{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qaos.local/schemas/common/defs.schema.json",
  "title": "QAOS Common Definitions",
  "$defs": {
    "SpecId": {
      "type": "string",
      "pattern": "^SPEC-[A-Z0-9]+-[0-9]{3,}$"
    },
    "SpecVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$"
    },
    "RequirementId": {
      "type": "string",
      "pattern": "^REQ-[A-Z0-9]+-[0-9]{3,}$"
    },
    "AcId": {
      "type": "string",
      "pattern": "^AC-[A-Z0-9]+-[0-9]{3,}$"
    },
    "TestCaseId": {
      "type": "string",
      "pattern": "^TC-[A-Z0-9]+-[0-9]{3,}$"
    },
    "FunctionalArea": {
      "type": "string",
      "pattern": "^[A-Z0-9]+$",
      "description": "與 spec.schema 的 functional_area、TestCaseId 的 area 段一致"
    },
    "TestCaseDraftId": {
      "type": "string",
      "pattern": "^TC-DRAFT-[0-9A-Z]{26}$"
    },
    "SuiteId": {
      "type": "string",
      "pattern": "^SUITE-(FULL|CI|HOTFIX|SMOKE|FEATURE)(-[A-Z0-9]+)?$"
    },
    "ExecutionId": {
      "type": "string",
      "pattern": "^EXE-[0-9]{8}-[0-9]{3,}$"
    },
    "EvidenceId": {
      "type": "string",
      "pattern": "^EVD-[0-9]{4,}$"
    },
    "BugId": {
      "type": "string",
      "pattern": "^BUG-[A-Z0-9]+-[0-9]{3,}$"
    },
    "ChangeImpactId": {
      "type": "string",
      "pattern": "^CI-SPEC-[A-Z0-9]+-[0-9]{3,}-[0-9.]+-[0-9.]+$"
    },
    "ArtifactId": {
      "type": "string",
      "pattern": "^ART-[A-Z]+-[0-9A-Z]{26}$"
    },
    "RunId": {
      "type": "string",
      "pattern": "^RUN-[0-9]{8}-[0-9]{3,}$"
    },
    "TaskId": {
      "type": "string",
      "pattern": "^T[0-9]+[A-Z]{0,2}$"
    },
    "ApprovalId": {
      "type": "string",
      "pattern": "^APR-[0-9]{4,}$"
    },
    "AgentId": {
      "type": "string",
      "pattern": "^agent-[a-z-]+$"
    },
    "HumanId": {
      "type": "string",
      "minLength": 1,
      "description": "email 或帳號；不得為 agent-*"
    },
    "ActionId": {
      "type": "string",
      "pattern": "^[A-Z_]+$"
    },
    "Sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "Timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "IntVersion": {
      "type": "integer",
      "minimum": 1
    },
    "TestLevel": {
      "type": "string",
      "enum": [
        "unit",
        "component",
        "integration",
        "api",
        "ui_e2e"
      ]
    },
    "TestType": {
      "type": "string",
      "enum": [
        "functional",
        "negative",
        "boundary",
        "security",
        "performance",
        "usability",
        "compatibility"
      ]
    },
    "ExecutionMode": {
      "type": "string",
      "enum": [
        "manual",
        "automated",
        "hybrid"
      ]
    },
    "AutomationStatus": {
      "type": "string",
      "enum": [
        "not_automated",
        "planned",
        "automated"
      ]
    },
    "Priority": {
      "type": "string",
      "enum": [
        "critical",
        "high",
        "medium",
        "low"
      ]
    },
    "Risk": {
      "type": "string",
      "enum": [
        "high",
        "medium",
        "low"
      ]
    },
    "Severity": {
      "type": "string",
      "enum": [
        "blocker",
        "critical",
        "major",
        "minor",
        "trivial"
      ]
    },
    "ExecutionCost": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "Stability": {
      "type": "string",
      "enum": [
        "unknown",
        "stable",
        "flaky"
      ]
    },
    "SuiteType": {
      "type": "string",
      "enum": [
        "full_regression",
        "ci_regression",
        "hotfix",
        "smoke",
        "feature"
      ]
    },
    "DesignTechnique": {
      "type": "string",
      "enum": [
        "requirement_based",
        "boundary_value",
        "equivalence_partitioning",
        "decision_table",
        "state_transition",
        "scenario",
        "negative",
        "error_guessing",
        "pairwise",
        "security_rule"
      ]
    },
    "TestCaseSource": {
      "type": "string",
      "enum": [
        "spec_workflow",
        "change_workflow",
        "manual_integration",
        "import"
      ]
    },
    "AmbiguityLevel": {
      "type": "string",
      "enum": [
        "critical",
        "major",
        "minor"
      ]
    },
    "IssueSeverity": {
      "type": "string",
      "enum": [
        "blocker",
        "major",
        "minor"
      ]
    },
    "ValidationResult": {
      "type": "string",
      "enum": [
        "PASS",
        "FAIL"
      ]
    },
    "BugValidationResult": {
      "type": "string",
      "enum": [
        "PASS",
        "FAIL",
        "DUPLICATE",
        "AMBIGUITY"
      ]
    },
    "TestCaseStatus": {
      "type": "string",
      "enum": [
        "DRAFT",
        "VALIDATING",
        "VALIDATION_FAILED",
        "VALIDATED",
        "PENDING_APPROVAL",
        "APPROVED",
        "ACTIVE",
        "SUPERSEDED",
        "RETIRED"
      ]
    },
    "BugStatus": {
      "type": "string",
      "enum": [
        "DRAFT",
        "VALIDATING",
        "VALIDATION_FAILED",
        "AMBIGUITY_ESCALATED",
        "VALIDATED",
        "PENDING_APPROVAL",
        "OPEN",
        "IN_PROGRESS",
        "RESOLVED",
        "VERIFIED",
        "CLOSED",
        "REJECTED"
      ]
    },
    "ChangeImpactStatus": {
      "type": "string",
      "enum": [
        "DETECTED",
        "ANALYZING",
        "NO_IMPACT",
        "IMPACTED",
        "TEST_UPDATE_REQUIRED",
        "VALIDATING",
        "COMPARING",
        "PENDING_APPROVAL",
        "APPLIED"
      ]
    },
    "RequirementStatus": {
      "type": "string",
      "enum": [
        "DRAFT",
        "ACTIVE",
        "CHANGED",
        "RETIRED"
      ]
    },
    "SuiteStatus": {
      "type": "string",
      "enum": [
        "DRAFT",
        "PENDING_APPROVAL",
        "ACTIVE",
        "RETIRED"
      ]
    },
    "ArtifactStatus": {
      "type": "string",
      "enum": [
        "DRAFT",
        "SUBMITTED",
        "VALID",
        "INVALID",
        "SUPERSEDED"
      ]
    },
    "RunStatus": {
      "type": "string",
      "enum": [
        "CREATED",
        "RUNNING",
        "WAITING_HUMAN",
        "COMPLETED",
        "FAILED",
        "CANCELLED"
      ]
    },
    "TaskStatus": {
      "type": "string",
      "enum": [
        "PENDING",
        "READY",
        "RUNNING",
        "ARTIFACT_INVALID",
        "GATE_FAILED",
        "DONE",
        "FAILED"
      ]
    },
    "ApprovalType": {
      "type": "string",
      "enum": [
        "ACTIVATE_TESTCASE",
        "REVIEW_TEST_ANALYSIS",
        "APPLY_CHANGE",
        "RETIRE_TESTCASE",
        "OPEN_BUG",
        "CLOSE_BUG",
        "CHANGE_BUG_SEVERITY",
        "CONFIRM_DUPLICATE",
        "UPDATE_SUITE_MEMBERSHIP",
        "RESOLVE_AMBIGUITY",
        "HUMAN_OVERRIDE",
        "NEEDS_DECISION"
      ]
    },
    "ApprovalStatus": {
      "type": "string",
      "enum": [
        "PENDING",
        "DECIDED",
        "EXPIRED",
        "CANCELLED"
      ]
    },
    "Decision": {
      "type": "string",
      "enum": [
        "approve",
        "reject",
        "override"
      ]
    },
    "GateId": {
      "type": "string",
      "enum": [
        "G-SPEC",
        "G-DESIGN",
        "G-TVAL",
        "G-BVAL",
        "G-IMPACT",
        "G-COMPARE",
        "G-REG",
        "G-APPROVAL",
        "G-RISK"
      ]
    },
    "SpecReference": {
      "type": "object",
      "required": [
        "spec_id",
        "spec_version",
        "location"
      ],
      "properties": {
        "spec_id": {
          "$ref": "#/$defs/SpecId"
        },
        "spec_version": {
          "$ref": "#/$defs/SpecVersion"
        },
        "location": {
          "type": "string",
          "description": "章節 / 標題 / 行號範圍，例如 '§3.2 L120-L134'"
        },
        "quote": {
          "type": "string",
          "description": "原文引用（≤ 300 字）",
          "maxLength": 300
        }
      },
      "additionalProperties": false
    },
    "EntityRef": {
      "type": "object",
      "required": [
        "entity_type",
        "id"
      ],
      "properties": {
        "entity_type": {
          "type": "string",
          "enum": [
            "Spec",
            "SpecVersion",
            "Requirement",
            "AcceptanceCriterion",
            "TestCase",
            "TestCaseVersion",
            "TestSuite",
            "TestExecution",
            "Evidence",
            "Bug",
            "ChangeImpact",
            "Artifact",
            "WorkflowRun",
            "ApprovalRequest",
            "ManualTestRecord",
            "Clarification"
          ]
        },
        "id": {
          "type": "string"
        },
        "version": {
          "type": [
            "string",
            "integer"
          ]
        }
      },
      "additionalProperties": false
    },
    "HistoryEntry": {
      "type": "object",
      "required": [
        "at",
        "from_status",
        "to_status",
        "by",
        "trigger"
      ],
      "properties": {
        "at": {
          "$ref": "#/$defs/Timestamp"
        },
        "from_status": {
          "type": [
            "string",
            "null"
          ]
        },
        "to_status": {
          "type": "string"
        },
        "by": {
          "type": "string",
          "description": "agent_id | human_id | system"
        },
        "trigger": {
          "type": "string",
          "description": "artifact_id | approval_id | action_id"
        },
        "run_id": {
          "$ref": "#/$defs/RunId"
        },
        "note": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "Ambiguity": {
      "type": "object",
      "required": [
        "level",
        "description"
      ],
      "properties": {
        "level": {
          "$ref": "#/$defs/AmbiguityLevel"
        },
        "description": {
          "type": "string"
        },
        "options": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "可能的解讀，供 Human RESOLVE_AMBIGUITY"
        },
        "resolved_by_approval": {
          "$ref": "#/$defs/ApprovalId"
        }
      },
      "additionalProperties": false
    },
    "ValidationIssue": {
      "type": "object",
      "description": "Brief §7.4 八個必填欄位",
      "required": [
        "testcase_id",
        "issue_type",
        "severity",
        "violated_requirement",
        "spec_reference",
        "evidence",
        "explanation",
        "recommended_change"
      ],
      "properties": {
        "testcase_id": {
          "type": "string"
        },
        "issue_type": {
          "type": "string",
          "enum": [
            "spec_mismatch",
            "requirement_mismatch",
            "unsupported_assumption",
            "invalid_expected_result",
            "non_executable_steps",
            "missing_coverage",
            "missing_traceability",
            "duplicate",
            "unreasonable_edge_case",
            "critical_ambiguity",
            "missing_reference",
            "missing_negative_coverage",
            "technique_mismatch",
            "other"
          ]
        },
        "severity": {
          "$ref": "#/$defs/IssueSeverity"
        },
        "violated_requirement": {
          "type": [
            "string",
            "null"
          ],
          "description": "requirement_id 或 null（若為結構問題）"
        },
        "spec_reference": {
          "anyOf": [
            {
              "$ref": "#/$defs/SpecReference"
            },
            {
              "type": "null"
            }
          ]
        },
        "evidence": {
          "type": "string",
          "description": "驗證者引用的 Draft 內容 / Spec 原文對照"
        },
        "explanation": {
          "type": "string"
        },
        "recommended_change": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "ClarificationId": {
      "type": "string",
      "pattern": "^CLR-[A-Z0-9]+-[0-9]{3,}$"
    },
    "ClarificationStatus": {
      "type": "string",
      "enum": [
        "OPEN",
        "ASKED",
        "ANSWERED",
        "APPLIED",
        "WITHDRAWN"
      ]
    },
    "SpecPin": {
      "type": "object",
      "description": "spec 版本的身分：content_hash 必須同時等於 spec.yaml 登記值與實體檔 sha256（需求 A 第 2 章）",
      "required": [
        "spec_id",
        "spec_version",
        "content_hash"
      ],
      "properties": {
        "spec_id": {
          "$ref": "#/$defs/SpecId"
        },
        "spec_version": {
          "$ref": "#/$defs/SpecVersion"
        },
        "content_hash": {
          "$ref": "#/$defs/Sha256"
        }
      },
      "additionalProperties": false
    },
    "ReferenceRole": {
      "type": "string",
      "enum": [
        "normative",
        "informative"
      ]
    },
    "SpecReferenceDecl": {
      "type": "object",
      "description": "直接層引用（附錄 A 2-5）：SpecPin＋role＋scope；decl_rev、depth 只在閉包展開時計算",
      "required": [
        "spec_id",
        "spec_version",
        "content_hash",
        "role"
      ],
      "properties": {
        "spec_id": {
          "$ref": "#/$defs/SpecId"
        },
        "spec_version": {
          "$ref": "#/$defs/SpecVersion"
        },
        "content_hash": {
          "$ref": "#/$defs/Sha256"
        },
        "role": {
          "$ref": "#/$defs/ReferenceRole"
        },
        "scope": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "RefNode": {
      "type": "object",
      "description": "引用閉包中的一個節點：SpecPin＋decl_rev＋role＋depth",
      "required": [
        "spec_id",
        "spec_version",
        "content_hash",
        "decl_rev",
        "role",
        "depth"
      ],
      "properties": {
        "spec_id": {
          "$ref": "#/$defs/SpecId"
        },
        "spec_version": {
          "$ref": "#/$defs/SpecVersion"
        },
        "content_hash": {
          "$ref": "#/$defs/Sha256"
        },
        "decl_rev": {
          "type": "integer",
          "minimum": 0
        },
        "role": {
          "$ref": "#/$defs/ReferenceRole"
        },
        "depth": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    }
  }
}

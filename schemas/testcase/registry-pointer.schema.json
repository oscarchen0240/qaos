{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qaos.local/schemas/testcase/registry-pointer.schema.json",
  "title": "RegistryPointer",
  "description": "testcases/registry/<tc_id>.yaml — 只存 pointer，不存內容",
  "type": "object",
  "required": ["testcase_id", "active_version", "status", "versions"],
  "properties": {
    "testcase_id": {"$ref": "../common/defs.schema.json#/$defs/TestCaseId"},
    "active_version": {"type": ["integer", "null"]},
    "status": {"type": "string", "enum": ["ACTIVE", "RETIRED", "NO_ACTIVE_VERSION"]},
    "versions": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["version", "status"], "properties": {"version": {"type": "integer"}, "status": {"$ref": "../common/defs.schema.json#/$defs/TestCaseStatus"}, "superseded_by": {"type": ["integer", "null"]}, "activated_by_approval": {"$ref": "../common/defs.schema.json#/$defs/ApprovalId"}}}}
  },
  "additionalProperties": false
}

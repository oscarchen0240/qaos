{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qaos.local/schemas/testcase/manual-test-record.schema.json",
  "title": "ManualTestRecord",
  "description": "testcases/manual/<record_id>.yaml — Human 寫入的人工測試原始紀錄，WF-D 的輸入",
  "type": "object",
  "required": ["record_id", "title", "tester", "tested_at", "environment", "steps_performed", "observed_result", "outcome"],
  "properties": {
    "record_id": {"type": "string", "pattern": "^MAN-[0-9]{8}-[0-9]{3,}$"},
    "title": {"type": "string"},
    "tester": {"$ref": "../common/defs.schema.json#/$defs/HumanId"},
    "tested_at": {"$ref": "../common/defs.schema.json#/$defs/Timestamp"},
    "product": {"type": "string"},
    "functional_area": {"type": "string"},
    "spec_hint": {"type": "object", "properties": {"spec_id": {"$ref": "../common/defs.schema.json#/$defs/SpecId"}, "spec_version": {"$ref": "../common/defs.schema.json#/$defs/SpecVersion"}, "requirement_ids": {"type": "array", "items": {"$ref": "../common/defs.schema.json#/$defs/RequirementId"}}}},
    "environment": {"type": "string"},
    "preconditions": {"type": "array", "items": {"type": "string"}},
    "steps_performed": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "observed_result": {"type": "string"},
    "outcome": {"type": "string", "enum": ["pass", "fail", "blocked"]},
    "evidence_ids": {"type": "array", "items": {"$ref": "../common/defs.schema.json#/$defs/EvidenceId"}},
    "execution_id": {"$ref": "../common/defs.schema.json#/$defs/ExecutionId"},
    "notes": {"type": "string"}
  },
  "additionalProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qaos.local/schemas/workflow/workflow-run.schema.json",
  "title": "WorkflowRun",
  "description": "runs/<run_id>/run.yaml",
  "type": "object",
  "required": ["run_id", "workflow_id", "workflow_version", "status", "input", "initiated_by", "created_at", "tasks", "history"],
  "properties": {
    "run_id": {"$ref": "../common/defs.schema.json#/$defs/RunId"},
    "workflow_id": {"type": "string"},
    "workflow_version": {"type": "string"},
    "status": {"$ref": "../common/defs.schema.json#/$defs/RunStatus"},
    "input": {"type": "object"},
    "initiated_by": {"$ref": "../common/defs.schema.json#/$defs/HumanId"},
    "requirement_model_revision": {"$ref": "../common/defs.schema.json#/$defs/RMPin", "description": "run 的需求模型依據（需求 A 第 5 章 §4）；spec-change-impact 時是 to 端"},
    "from_requirement_model_revision": {"$ref": "../common/defs.schema.json#/$defs/RMPin", "description": "spec-change-impact 的 from 端"},
    "testcase_pin": {"$ref": "../common/defs.schema.json#/$defs/RMPin", "description": "testcase-revision：被修訂 TC 自己的舊 pin，供 diff 使用"},
    "created_at": {"$ref": "../common/defs.schema.json#/$defs/Timestamp"},
    "updated_at": {"$ref": "../common/defs.schema.json#/$defs/Timestamp"},
    "current_task_id": {"$ref": "../common/defs.schema.json#/$defs/TaskId"},
    "waiting_on_approval_id": {"$ref": "../common/defs.schema.json#/$defs/ApprovalId"},
    "tasks": {"type": "array", "items": {"$ref": "task.schema.json"}},
    "summary_artifact_id": {"$ref": "../common/defs.schema.json#/$defs/ArtifactId"},
    "history": {"type": "array", "items": {"$ref": "../common/defs.schema.json#/$defs/HistoryEntry"}}
  },
  "additionalProperties": false
}

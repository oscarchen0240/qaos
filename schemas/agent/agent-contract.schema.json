{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qaos.local/schemas/agent/agent-contract.schema.json",
  "title": "AgentContract",
  "type": "object",
  "required": ["id", "name", "version", "purpose", "responsibilities", "input_schema", "output_schema", "allowed_actions", "forbidden_actions", "dependencies", "consumes", "produces", "quality_gate", "failure_handling", "human_approval_required", "write_paths"],
  "properties": {
    "id": {"$ref": "../common/defs.schema.json#/$defs/AgentId"},
    "name": {"type": "string"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "purpose": {"type": "string", "minLength": 20},
    "modes": {"type": "object", "additionalProperties": {"type": "object", "properties": {"input": {"type": "array"}, "rule": {"type": "string"}}}},
    "phases": {"type": "object"},
    "responsibilities": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "input_schema": {"anyOf": [{"type": "string"}, {"type": "array", "items": {"type": "string"}}]},
    "output_schema": {"anyOf": [{"type": "string"}, {"type": "array", "items": {"type": "string"}}]},
    "allowed_actions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "../common/defs.schema.json#/$defs/ActionId"}},
    "forbidden_actions": {"type": "array", "items": {"type": "string"}},
    "dependencies": {"type": "object", "properties": {"skills": {"type": "array", "items": {"type": "string"}}, "agents": {"type": "array", "items": {"type": "string"}}, "runtime": {"type": "array", "items": {"type": "string"}}}},
    "consumes": {"type": "array", "items": {"type": "string"}},
    "produces": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "quality_gate": {"anyOf": [{"type": "string"}, {"type": "array", "items": {"type": "string"}}, {"type": "object"}]},
    "failure_handling": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string"}},
    "human_approval_required": {"type": "array", "items": {"type": "string"}},
    "write_paths": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}

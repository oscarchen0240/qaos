{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qaos.local/schemas/spec/binding.schema.json",
  "title": "RequirementModelBinding",
  "description": "sidecar：不修改原檔，另外記錄 RMPin（需求 A 第 5 章 §4）。run：artifacts/requirements/_bindings/<run_id>.yaml；TC：testcases/_bindings/<tc_id>-v<N>.yaml",
  "type": "object",
  "required": ["subject", "legacy_binding", "created_by_op"],
  "properties": {
    "subject": {"type": "object", "properties": {"run_id": {"$ref": "../common/defs.schema.json#/$defs/RunId"}, "testcase_id": {"$ref": "../common/defs.schema.json#/$defs/TestCaseId"}, "version": {"type": "integer", "minimum": 1}}, "additionalProperties": false},
    "requirement_model_revision": {"$ref": "../common/defs.schema.json#/$defs/RMPin"},
    "from_requirement_model_revision": {"$ref": "../common/defs.schema.json#/$defs/RMPin"},
    "binding": {"const": "none", "description": "移轉時沒有 spec 的既有 manual run（附錄 A 5-4）"},
    "legacy_binding": {"type": "boolean", "description": "true：移轉時的盡力綁定，不宣稱是當時實際使用的模型"},
    "created_by_op": {"type": "string"}
  },
  "additionalProperties": false
}

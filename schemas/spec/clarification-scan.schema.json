{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qaos.local/schemas/spec/clarification-scan.schema.json",
  "title": "ClarificationScan",
  "description": "clarification impact 保存的掃描紀錄（需求 A 第 6 章 §4）：apply 的關鍵字來源之一，不是 CLR 狀態的證據",
  "type": "object",
  "required": [
    "scan_id",
    "clr_id",
    "answer_rev",
    "keywords",
    "targets",
    "scan_units",
    "rule_version",
    "candidates",
    "scanned_at",
    "op_id",
    "sha256"
  ],
  "properties": {
    "scan_id": {
      "type": "string",
      "pattern": "^SCAN-[0-9A-Z]{26}$"
    },
    "clr_id": {
      "$ref": "../common/defs.schema.json#/$defs/ClarificationId"
    },
    "answer_rev": {
      "type": "integer",
      "minimum": 0
    },
    "keywords": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "targets": {
      "type": "array"
    },
    "scan_units": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "product",
          "area"
        ]
      }
    },
    "rule_version": {
      "type": "string"
    },
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "tc_id",
          "active_version",
          "tc_version_sha256",
          "reasons"
        ]
      }
    },
    "scanned_at": {
      "type": "string"
    },
    "op_id": {
      "type": "string"
    },
    "sha256": {
      "$ref": "../common/defs.schema.json#/$defs/Sha256"
    }
  },
  "additionalProperties": false
}

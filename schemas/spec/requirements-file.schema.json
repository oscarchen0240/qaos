{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qaos.local/schemas/spec/requirements-file.schema.json",
  "title": "RequirementsFile",
  "description": "artifacts/requirements/<spec_id>/v<ver>/requirements.yaml — 持久化的 RequirementModel（G-SPEC PASS 後由 Runtime 寫入）",
  "type": "object",
  "required": ["spec_id", "spec_version", "source_artifact_id", "persisted_at", "requirements"],
  "properties": {
    "spec_id": {"$ref": "../common/defs.schema.json#/$defs/SpecId"},
    "spec_version": {"$ref": "../common/defs.schema.json#/$defs/SpecVersion"},
    "source_artifact_id": {"$ref": "../common/defs.schema.json#/$defs/ArtifactId"},
    "persisted_at": {"$ref": "../common/defs.schema.json#/$defs/Timestamp"},
    "requirements": {"type": "array", "minItems": 1, "items": {"$ref": "requirement.schema.json"}}
  },
  "additionalProperties": false
}

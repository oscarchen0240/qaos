{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qaos.local/schemas/artifact/test-validator-input.schema.json",
  "title": "TestValidatorInput",
  "description": "Supervisor DISPATCH_AGENT 時交給 Agent 的輸入包；所有 artifact 以 id 傳遞，Agent 用 READ_ARTIFACT 讀取",
  "type": "object",
  "required": ["run_id","task_id","iteration","spec_id","spec_version","requirement_model_artifact_id","testcase_draft_artifact_id","test_design_report_artifact_id"],
  "properties": {
    "run_id": {"$ref": "../common/defs.schema.json#/$defs/RunId"},
    "task_id": {"$ref": "../common/defs.schema.json#/$defs/TaskId"},
    "iteration": {"type": "integer", "minimum": 0},
    "spec_id": {"$ref": "../common/defs.schema.json#/$defs/SpecId"},
    "spec_version": {"$ref": "../common/defs.schema.json#/$defs/SpecVersion"},
    "requirement_model_artifact_id": {"$ref": "../common/defs.schema.json#/$defs/ArtifactId"},
    "testcase_draft_artifact_id": {"$ref": "../common/defs.schema.json#/$defs/ArtifactId"},
    "test_design_report_artifact_id": {"$ref": "../common/defs.schema.json#/$defs/ArtifactId", "description": "Validator 只讀 coverage_matrix / uncovered_with_reason"},
    "existing_active_testcase_ids": {"type": "array", "items": {"$ref": "../common/defs.schema.json#/$defs/TestCaseId"}},
    "resolved_ambiguity_approval_ids": {"type": "array", "items": {"$ref": "../common/defs.schema.json#/$defs/ApprovalId"}}
  },
  "additionalProperties": false
}

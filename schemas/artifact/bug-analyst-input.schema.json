{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qaos.local/schemas/artifact/bug-analyst-input.schema.json",
  "title": "BugAnalystInput",
  "description": "Supervisor DISPATCH_AGENT 時交給 Agent 的輸入包；所有 artifact 以 id 傳遞，Agent 用 READ_ARTIFACT 讀取",
  "type": "object",
  "required": ["run_id","task_id","iteration","spec_id","spec_version","requirement_model_artifact_id","evidence_ids"],
  "properties": {
    "run_id": {"$ref": "../common/defs.schema.json#/$defs/RunId"},
    "task_id": {"$ref": "../common/defs.schema.json#/$defs/TaskId"},
    "iteration": {"type": "integer", "minimum": 0},
    "spec_id": {"$ref": "../common/defs.schema.json#/$defs/SpecId"},
    "spec_version": {"$ref": "../common/defs.schema.json#/$defs/SpecVersion"},
    "requirement_model_artifact_id": {"$ref": "../common/defs.schema.json#/$defs/ArtifactId"},
    "execution_id": {"$ref": "../common/defs.schema.json#/$defs/ExecutionId"},
    "actual_behavior": {"type": "string"},
    "evidence_ids": {"type": "array", "minItems": 1, "items": {"$ref": "../common/defs.schema.json#/$defs/EvidenceId"}},
    "testcase_id": {"$ref": "../common/defs.schema.json#/$defs/TestCaseId"},
    "testcase_version": {"type": "integer"},
    "environment": {"type": "object"},
    "validation_report_artifact_id": {"$ref": "../common/defs.schema.json#/$defs/ArtifactId"},
    "rejection_rationale": {"type": "string"}
  },
  "additionalProperties": false
}

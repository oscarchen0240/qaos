{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qaos.local/schemas/artifact/requirement-model.schema.json",
  "title": "RequirementModel (payload)",
  "type": "object",
  "required": ["spec_id", "spec_version", "requirements", "traceability"],
  "properties": {
    "spec_id": {"$ref": "../common/defs.schema.json#/$defs/SpecId"},
    "spec_version": {"$ref": "../common/defs.schema.json#/$defs/SpecVersion"},
    "requirements": {"type": "array", "minItems": 1, "items": {"$ref": "../spec/requirement.schema.json"}},
    "traceability": {"type": "array", "items": {"type": "object", "required": ["requirement_id", "spec_reference"], "properties": {"requirement_id": {"$ref": "../common/defs.schema.json#/$defs/RequirementId"}, "spec_reference": {"$ref": "../common/defs.schema.json#/$defs/SpecReference"}}}}
  },
  "additionalProperties": false
}

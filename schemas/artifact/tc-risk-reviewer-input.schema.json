{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qaos.local/schemas/artifact/tc-risk-reviewer-input.schema.json",
  "title": "TCRiskReviewerInput",
  "description": "Supervisor DISPATCH_AGENT 給 TC Risk Reviewer 的輸入包（ADR-009）。必須綁定 Validator 已審過的那份報告與 draft；不給 TestDesignReport（避免讀到 Designer 推理）",
  "type": "object",
  "required": ["run_id", "task_id", "iteration", "functional_area", "spec_id", "spec_version", "requirement_model_artifact_id", "testcase_draft_artifact_id", "validation_report_artifact_id"],
  "properties": {
    "run_id": {"$ref": "../common/defs.schema.json#/$defs/RunId"},
    "task_id": {"$ref": "../common/defs.schema.json#/$defs/TaskId"},
    "iteration": {"type": "integer", "minimum": 0},
    "functional_area": {"type": "string", "pattern": "^[A-Z]+$"},
    "spec_id": {"$ref": "../common/defs.schema.json#/$defs/SpecId"},
    "spec_version": {"$ref": "../common/defs.schema.json#/$defs/SpecVersion"},
    "requirement_model_artifact_id": {"$ref": "../common/defs.schema.json#/$defs/ArtifactId"},
    "testcase_draft_artifact_id": {"$ref": "../common/defs.schema.json#/$defs/ArtifactId", "description": "Validator 審過的那份 draft（派發時已剝除 design_rationale）"},
    "validation_report_artifact_id": {"$ref": "../common/defs.schema.json#/$defs/ArtifactId", "description": "本 run Validator 最新 VALID 的 TestValidationReport"},
    "existing_active_testcase_ids": {"type": "array", "items": {"$ref": "../common/defs.schema.json#/$defs/TestCaseId"}, "description": "同 area ACTIVE TC，用來判斷情境是否已被覆蓋"}
  },
  "additionalProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qaos.local/schemas/artifact/tc-risk-review.schema.json",
  "title": "TCRiskReview (payload)",
  "description": "高風險功能區（金流／餘額／帳務）TC 的 Opus 抽查結果。只提建議，不修改 TC、不擋 ACTIVATE；結果併入 ACTIVATE 核准單供 Human 判斷（ADR-009）。",
  "type": "object",
  "required": ["reviewed", "dimension_results", "findings", "summary"],
  "properties": {
    "reviewed": {
      "type": "object",
      "required": ["testcase_draft_artifact_id", "validation_report_artifact_id", "functional_area", "spec_id", "spec_version", "testcase_draft_ids"],
      "properties": {
        "testcase_draft_artifact_id": {"$ref": "../common/defs.schema.json#/$defs/ArtifactId"},
        "validation_report_artifact_id": {"$ref": "../common/defs.schema.json#/$defs/ArtifactId"},
        "functional_area": {"type": "string", "pattern": "^[A-Z]+$"},
        "spec_id": {"$ref": "../common/defs.schema.json#/$defs/SpecId"},
        "spec_version": {"$ref": "../common/defs.schema.json#/$defs/SpecVersion"},
        "testcase_draft_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "active_testcases_consulted": {"type": "array", "items": {"type": "string", "pattern": "^TC-[A-Z]+-[0-9]{3,}$"}, "description": "為判斷是否已被既有 ACTIVE TC 覆蓋而參考過的 TC"}
      },
      "additionalProperties": false
    },
    "dimension_results": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "required": ["dimension", "status", "rationale"],
        "properties": {
          "dimension": {"$ref": "#/$defs/Dimension"},
          "status": {"type": "string", "enum": ["covered", "gaps_found", "not_applicable"]},
          "rationale": {"type": "string", "minLength": 10}
        },
        "additionalProperties": false
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["finding_id", "dimension", "severity", "related_testcase_ids", "related_requirement_ids", "gap", "suggested_scenario", "spec_basis", "needs_clarification"],
        "properties": {
          "finding_id": {"type": "string", "pattern": "^RF-[0-9]{2,}$"},
          "dimension": {"$ref": "#/$defs/Dimension"},
          "severity": {"type": "string", "enum": ["high", "medium", "low"]},
          "related_testcase_ids": {"type": "array", "items": {"type": "string"}, "description": "本次 draft_id 或同 area ACTIVE TC id；新情境無對應 TC 時可為空"},
          "related_requirement_ids": {"type": "array", "minItems": 1, "items": {"$ref": "../common/defs.schema.json#/$defs/RequirementId"}},
          "gap": {"type": "string", "minLength": 10},
          "suggested_scenario": {"type": "string", "minLength": 10},
          "spec_basis": {
            "anyOf": [
              {"type": "null"},
              {"type": "object", "required": ["location", "quote"], "properties": {"location": {"type": "string", "pattern": "\\S"}, "quote": {"type": "string", "pattern": "\\S"}}, "additionalProperties": false}
            ]
          },
          "needs_clarification": {"type": "boolean"}
        },
        "additionalProperties": false
      }
    },
    "summary": {"type": "string", "minLength": 10}
  },
  "additionalProperties": false,
  "$defs": {
    "Dimension": {"type": "string", "enum": ["boundary", "exception_flow", "concurrency", "duplicate_submission", "permission"]}
  }
}

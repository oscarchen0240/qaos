{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qaos.local/schemas/artifact/bug-draft.schema.json",
  "title": "BugDraft (payload)",
  "description": "與 Bug schema 同構，但 bug_id 為暫時 ID、status=DRAFT、severity/priority 為建議",
  "type": "object",
  "required": ["draft_id", "title", "product", "functional_area", "severity_proposed", "priority_proposed", "severity_rationale", "environment", "spec_id", "spec_version", "requirement_id", "preconditions", "reproduction_steps", "expected_result", "expected_result_spec_reference", "actual_result", "actual_result_evidence_map", "evidence_ids", "impact", "suspected_area", "ambiguity_suspected", "duplicate_candidates"],
  "properties": {
    "draft_id": {"type": "string", "pattern": "^BUG-DRAFT-[0-9A-Z]{26}$"},
    "title": {"type": "string", "minLength": 5},
    "product": {"type": "string"},
    "functional_area": {"type": "string"},
    "severity_proposed": {"$ref": "../common/defs.schema.json#/$defs/Severity"},
    "priority_proposed": {"$ref": "../common/defs.schema.json#/$defs/Priority"},
    "severity_rationale": {"type": "string"},
    "environment": {"type": "object", "required": ["name"], "additionalProperties": {"type": "string"}},
    "spec_id": {"$ref": "../common/defs.schema.json#/$defs/SpecId"},
    "spec_version": {"$ref": "../common/defs.schema.json#/$defs/SpecVersion"},
    "requirement_id": {"$ref": "../common/defs.schema.json#/$defs/RequirementId"},
    "acceptance_criteria_ids": {"type": "array", "items": {"$ref": "../common/defs.schema.json#/$defs/AcId"}},
    "testcase_id": {"$ref": "../common/defs.schema.json#/$defs/TestCaseId"},
    "testcase_version": {"type": "integer"},
    "execution_id": {"$ref": "../common/defs.schema.json#/$defs/ExecutionId"},
    "preconditions": {"type": "array", "items": {"type": "string"}},
    "reproduction_steps": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "expected_result": {"type": "string"},
    "expected_result_spec_reference": {"$ref": "../common/defs.schema.json#/$defs/SpecReference"},
    "actual_result": {"type": "string"},
    "actual_result_evidence_map": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["claim", "evidence_id"], "properties": {"claim": {"type": "string"}, "evidence_id": {"$ref": "../common/defs.schema.json#/$defs/EvidenceId"}}}},
    "evidence_ids": {"type": "array", "minItems": 1, "items": {"$ref": "../common/defs.schema.json#/$defs/EvidenceId"}},
    "api": {"type": "object", "properties": {"url": {"type": "string"}, "method": {"type": "string"}, "request_evidence_id": {"$ref": "../common/defs.schema.json#/$defs/EvidenceId"}, "response_evidence_id": {"$ref": "../common/defs.schema.json#/$defs/EvidenceId"}}},
    "impact": {"type": "string"},
    "suspected_area": {"type": "string"},
    "ambiguity_suspected": {"type": "boolean"},
    "ambiguity_note": {"type": "string"},
    "duplicate_candidates": {"type": "array", "items": {"type": "object", "required": ["bug_id", "similarity_note"], "properties": {"bug_id": {"$ref": "../common/defs.schema.json#/$defs/BugId"}, "similarity_note": {"type": "string"}}}}
  },
  "additionalProperties": false
}

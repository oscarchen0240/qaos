{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qaos.local/schemas/artifact/change-impact-report.schema.json",
  "title": "ChangeImpactReport (payload)",
  "type": "object",
  "required": ["change_impact_id", "spec_id", "from_version", "to_version", "from_rm_revision", "to_rm_revision", "requirement_diff", "pin_groups", "testcase_impact", "summary", "completeness"],
  "properties": {
    "change_impact_id": {"$ref": "../common/defs.schema.json#/$defs/ChangeImpactId"},
    "spec_id": {"$ref": "../common/defs.schema.json#/$defs/SpecId"},
    "from_version": {"$ref": "../common/defs.schema.json#/$defs/SpecVersion"},
    "to_version": {"$ref": "../common/defs.schema.json#/$defs/SpecVersion"},
    "from_rm_revision": {"$ref": "../common/defs.schema.json#/$defs/RMPin", "description": "run 綁定的 from 端 revision（需求 A 第 5 章 §8）"},
    "to_rm_revision": {"$ref": "../common/defs.schema.json#/$defs/RMPin", "description": "run 綁定的 to 端 revision"},
    "pin_groups": {"type": "array", "description": "依每張候選 TC 自己的 RMPin 分組（需求 A 第 5 章 §9）；候選 = 該 spec 全部 ACTIVE TC", "items": {"type": "object", "required": ["from_pin", "testcase_ids", "requirement_diff"], "properties": {"from_pin": {"$ref": "../common/defs.schema.json#/$defs/RMPin"}, "testcase_ids": {"type": "array", "items": {"$ref": "../common/defs.schema.json#/$defs/TestCaseId"}}, "requirement_diff": {"type": "array", "items": {"type": "object", "required": ["requirement_id", "change"], "properties": {"requirement_id": {"$ref": "../common/defs.schema.json#/$defs/RequirementId"}, "change": {"type": "string", "enum": ["unchanged", "changed", "added", "removed"]}, "detail": {"type": "string"}}}}}, "additionalProperties": false}},
    "requirement_diff": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["requirement_id", "change"], "properties": {"requirement_id": {"$ref": "../common/defs.schema.json#/$defs/RequirementId"}, "change": {"type": "string", "enum": ["unchanged", "changed", "added", "removed"]}, "detail": {"type": "string"}, "from_reference": {"$ref": "../common/defs.schema.json#/$defs/SpecReference"}, "to_reference": {"$ref": "../common/defs.schema.json#/$defs/SpecReference"}}}},
    "testcase_impact": {"type": "array", "items": {"type": "object", "required": ["testcase_id", "active_version", "impact", "reason", "affected_requirement_ids", "pin_group_index"], "properties": {"testcase_id": {"$ref": "../common/defs.schema.json#/$defs/TestCaseId"}, "active_version": {"type": "integer"}, "pin_group_index": {"type": "integer", "minimum": 0, "description": "該 TC 所屬 pin_groups 的索引"}, "impact": {"type": "string", "enum": ["unaffected", "affected", "obsolete", "new_required"]}, "reason": {"type": "string"}, "affected_requirement_ids": {"type": "array", "items": {"$ref": "../common/defs.schema.json#/$defs/RequirementId"}}, "in_suites": {"type": "array", "items": {"$ref": "../common/defs.schema.json#/$defs/SuiteId"}}}}},
    "new_required": {"type": "array", "items": {"type": "object", "required": ["requirement_id", "reason"], "properties": {"requirement_id": {"$ref": "../common/defs.schema.json#/$defs/RequirementId"}, "reason": {"type": "string"}}}},
    "summary": {"type": "object", "required": ["requirements_changed", "requirements_added", "requirements_removed", "testcases_affected", "testcases_obsolete", "testcases_unaffected"], "additionalProperties": {"type": "integer"}},
    "completeness": {"type": "object", "required": ["all_active_requirements_judged", "all_referencing_testcases_judged"], "properties": {"all_active_requirements_judged": {"type": "boolean"}, "all_referencing_testcases_judged": {"type": "boolean"}}},
    "hotfix_suite_recommendation": {"type": "array", "items": {"$ref": "../common/defs.schema.json#/$defs/TestCaseId"}}
  },
  "additionalProperties": false
}

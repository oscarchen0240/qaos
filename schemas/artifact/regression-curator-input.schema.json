{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qaos.local/schemas/artifact/regression-curator-input.schema.json",
  "title": "RegressionCuratorInput",
  "description": "Supervisor DISPATCH_AGENT 時交給 Agent 的輸入包；所有 artifact 以 id 傳遞，Agent 用 READ_ARTIFACT 讀取",
  "type": "object",
  "required": ["run_id","task_id","iteration","target_suite_type","scope","trigger"],
  "properties": {
    "run_id": {"$ref": "../common/defs.schema.json#/$defs/RunId"},
    "task_id": {"$ref": "../common/defs.schema.json#/$defs/TaskId"},
    "iteration": {"type": "integer", "minimum": 0},
    "target_suite_type": {"$ref": "../common/defs.schema.json#/$defs/SuiteType"},
    "suite_id": {"$ref": "../common/defs.schema.json#/$defs/SuiteId"},
    "current_suite_version": {"type": ["integer", "null"]},
    "scope": {"type": "string", "enum": ["all", "functional_area", "impacted", "single_testcase"]},
    "functional_area": {"type": "string"},
    "trigger": {"type": "string", "enum": ["manual", "post_change", "hotfix", "manual_integration"]},
    "change_impact_artifact_id": {"$ref": "../common/defs.schema.json#/$defs/ArtifactId"},
    "candidate_testcase_ids": {"type": "array", "items": {"$ref": "../common/defs.schema.json#/$defs/TestCaseId"}},
    "rejection_rationale": {"type": "string"}
  },
  "additionalProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qaos.local/schemas/artifact/bug-validator-input.schema.json",
  "title": "BugValidatorInput",
  "description": "Supervisor DISPATCH_AGENT 時交給 Agent 的輸入包；所有 artifact 以 id 傳遞，Agent 用 READ_ARTIFACT 讀取",
  "type": "object",
  "required": ["run_id","task_id","iteration","spec_id","spec_version","requirement_model_artifact_id","bug_draft_artifact_id"],
  "properties": {
    "run_id": {"$ref": "../common/defs.schema.json#/$defs/RunId"},
    "task_id": {"$ref": "../common/defs.schema.json#/$defs/TaskId"},
    "iteration": {"type": "integer", "minimum": 0},
    "spec_id": {"$ref": "../common/defs.schema.json#/$defs/SpecId"},
    "spec_version": {"$ref": "../common/defs.schema.json#/$defs/SpecVersion"},
    "requirement_model_artifact_id": {"$ref": "../common/defs.schema.json#/$defs/ArtifactId"},
    "bug_draft_artifact_id": {"$ref": "../common/defs.schema.json#/$defs/ArtifactId"},
    "existing_bug_ids_same_area": {"type": "array", "items": {"$ref": "../common/defs.schema.json#/$defs/BugId"}}
  },
  "additionalProperties": false
}

#!/usr/bin/env python3
"""以 QAOS hooks 啟動 Codex——只給需要指揮台守門／紀錄／交接的 QAOS 產品流程用。

一般 Codex 與審查 session 直接跑 `codex` 即可：repo 裡刻意沒有 `.codex/hooks.json`，
所以不會載入任何 QAOS hook，也不會跳「Hooks need review」。

用法（參數原樣轉給 codex，hooks 以 -c 傳入，來源為 sessionFlags）：
  admin-ui/hooks/codex/qaos-codex [codex 的參數／子命令／提示…]
  admin-ui/hooks/codex/qaos-codex --qaos-print-flags    只印出會加上的 -c 參數（JSON），不啟動

信任：第一次啟動 Codex 會跳「Hooks need review」，選 Trust all and continue 一次即可。
sessionFlags hook 的信任 key 與路徑無關（/<session-flags>/config.toml:...），所以各 worktree 共用同一份信任；
hook 內容（command／timeout／matcher）有改動才需要重新確認。本腳本不會寫入你的 Codex 信任設定。

hook 指令用 `git rev-parse --show-toplevel`（可用 QAOS_PROJECT_DIR 覆寫）找專案根，因為 Codex 不會設 CLAUDE_PROJECT_DIR。
"""
import json
import os
import shutil
import sys
from pathlib import Path

DEFAULT_CODEX = "/Applications/ChatGPT.app/Contents/Resources/codex-cli/CodexCLI.app/Contents/MacOS/codex"


def _toml(v) -> str:
    if isinstance(v, bool):
        return "true" if v else "false"
    if isinstance(v, (int, float)):
        return str(v)
    if isinstance(v, str):
        return json.dumps(v, ensure_ascii=False)
    if isinstance(v, list):
        return "[" + ",".join(_toml(x) for x in v) + "]"
    if isinstance(v, dict):
        return "{" + ",".join(f"{k}={_toml(x)}" for k, x in v.items()) + "}"
    raise TypeError(type(v))


def config_flags(definition: dict) -> list[str]:
    flags: list[str] = []
    for event, groups in definition["hooks"].items():
        flags += ["-c", f"hooks.{event}={_toml(groups)}"]
    return flags


def find_codex() -> str:
    for cand in (os.environ.get("CODEX_BIN"), shutil.which("codex"), os.environ.get("CODEX_CLI_PATH"), DEFAULT_CODEX):
        if cand and os.access(cand, os.X_OK):
            return cand
    sys.exit("找不到 codex 執行檔（可用 CODEX_BIN 指定）")


def main() -> None:
    definition = json.loads(Path(__file__).resolve().with_name("qaos-hooks.json").read_text(encoding="utf-8"))
    flags = config_flags(definition)
    args = sys.argv[1:]
    if args[:1] == ["--qaos-print-flags"]:
        print(json.dumps(flags, ensure_ascii=False))
        return
    codex = find_codex()
    os.execv(codex, [codex, *flags, *args])


if __name__ == "__main__":
    main()

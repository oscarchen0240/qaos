#!/usr/bin/env python3
"""由 .claude/agents/*.md 產生 .codex/agents/*.toml（內容一致，只做下方 SUBSTITUTIONS 列的宿主用語替換）。

  admin-ui/hooks/codex/sync-agents           寫入（覆蓋）.codex/agents/*.toml
  admin-ui/hooks/codex/sync-agents --check   只檢查，有差異就列出並以 1 結束

.claude/agents 是來源；改了它之後要重跑本腳本，並把產生的 toml 一起 commit（test_codex_agents_match_claude_agents 會把關）。
"""
import json
import re
import sys
import tomllib
from pathlib import Path

try:
    import yaml
except ImportError:  # pragma: no cover
    sys.exit("需要 PyYAML（admin-ui/.venv 已有；或 pip install pyyaml）")

ROOT = Path(__file__).resolve().parents[3]
SUBSTITUTIONS = {"qaos-test-designer": [("Claude Code session", "Codex session")]}


def render(md_path: Path) -> str:
    m = re.match(r"^---\n(.*?)\n---\n(.*)$", md_path.read_text(encoding="utf-8"), re.S)
    if not m:
        raise SystemExit(f"{md_path}: 找不到 frontmatter")
    front = yaml.safe_load(m.group(1))
    if not isinstance(front, dict) or not all(isinstance(front.get(k), str) and front[k] for k in ("name", "description")):
        raise SystemExit(f"{md_path}: frontmatter 的 name、description 必須是非空字串")
    body = m.group(2).strip()
    for old, new in SUBSTITUTIONS.get(md_path.stem, []):
        if old not in body:
            raise SystemExit(f"{md_path.stem}: 允許的替換 {old!r} 在 Claude 版找不到，請更新 SUBSTITUTIONS")
        body = body.replace(old, new)
    # 基本多行字串：反斜線要加倍；連續 3 個以上的雙引號（以及貼著結尾分隔符的雙引號）要逐一跳脫
    escaped = re.sub(r'"{3,}|"+$', lambda q: '\\"' * len(q.group()), body.replace("\\", "\\\\"))
    text = f'name = {json.dumps(front["name"], ensure_ascii=False)}\ndescription = {json.dumps(front["description"], ensure_ascii=False)}\ndeveloper_instructions = """\n{escaped}"""\n'
    try:
        parsed = tomllib.loads(text)
    except tomllib.TOMLDecodeError as e:
        raise SystemExit(f"{md_path.stem}: 產生的 toml 不合法：{e}")
    if (parsed["name"], parsed["description"], parsed["developer_instructions"].strip()) != (front["name"], front["description"], body) or parsed["name"] != md_path.stem:
        raise SystemExit(f"{md_path.stem}: 產生的 toml 解析後與來源（name／description／本文）不一致")
    return text


def main() -> int:
    check = "--check" in sys.argv[1:]
    out_dir = ROOT / ".codex" / "agents"
    mds = sorted((ROOT / ".claude" / "agents").glob("*.md"))
    rendered = {md.stem: render(md) for md in mds}          # 全部先產生並驗證過，才開始寫入（不會只更新一半）
    drift = []
    for stem, text in rendered.items():
        target = out_dir / f"{stem}.toml"
        if not target.exists() or target.read_text(encoding="utf-8") != text:
            drift.append(target.name)
            if not check:
                out_dir.mkdir(parents=True, exist_ok=True)
                target.write_text(text, encoding="utf-8")
    extra = sorted(p.name for p in out_dir.glob("*.toml") if p.stem not in {m.stem for m in mds}) if out_dir.exists() else []
    if check:
        for d in drift:
            print(f"需要同步：{d}")
        for e in extra:
            print(f"多出的檔案（.claude/agents 沒有對應）：{e}")
        return 1 if drift or extra else 0
    print(f"已更新 {len(drift)} 份：{', '.join(drift) or '（無）'}")
    return 1 if extra else 0


if __name__ == "__main__":
    sys.exit(main())

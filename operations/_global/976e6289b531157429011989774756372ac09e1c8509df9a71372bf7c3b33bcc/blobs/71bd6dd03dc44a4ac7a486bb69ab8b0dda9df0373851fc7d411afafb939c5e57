    '<div class="field" id="plans-msg" style="margin:0;"><p class="field-error-msg" style="margin:0 0 8px;">預設規則關閉時，至少須新增一個等級規則</p></div>';
  plans.forEach((p,i)=>{if(p.def&&off)return;renderPlanCost(i);renderAuditWarn(i);if(p.reward==='random')renderWtSum(i);});
  renderOverall();
}
function addPlan(){
  if(LEVELS.every(l=>ownerOf(l)!==-1)){showToast('所有會員等級皆已指定規則');return;}
  clearErr('plans-msg');plans.push(newPlan(false));renderPlans();
}
function rmPlan(i){plans.splice(i,1);renderPlans();}
function togglePlanLevel(i,l,on){
  const p=plans[i];
  p.levels=on?[...p.levels,l]:p.levels.filter(x=>x!==l);
  renderPlans();
}
function setP(i,k,v){plans[i][k]=v;clearErr(`pf-${i}-${k}`);renderPlanCost(i);if(k==='audit')renderAuditWarn(i);}
function setReward(i,r){plans[i].reward=r;renderPlans();}
function setWt(i,j,k,v){plans[i].wt[j][k]=parseFloat(v)||0;clearErr(`pf-${i}-wt`);renderWtSum(i);renderPlanCost(i);}
function addWt(i){plans[i].wt.push([0,0]);renderPlans();}
function rmWt(i,j){if(plans[i].wt.length<=1){showToast('權重表至少須保留一列');return;}plans[i].wt.splice(j,1);renderPlans();}
function renderWtSum(i){
  const s=plans[i].wt.reduce((a,w)=>a+w[1],0);
  const ok=Math.abs(s-100)<1e-9;
  const el=document.getElementById(`pw-${i}-sum`);if(!el)return;
  el.innerHTML=`機率合計：<span style="color:${ok?'var(--green-text)':'var(--red-text)'};">${+s.toFixed(2)}%</span>${ok?'':'（須為 100%）'}`;
}
// 成本試算：新增表單與紅包明細共用同一套算法（逐規則）
function calcCost(c){
  let exp=0,max=0,partial=false;
  if(c.reward==='fixed'){exp=max=parseFloat(c.fixed)||0;}
  else{exp=c.wt.reduce((a,w)=>a+w[0]*w[1]/100,0);max=Math.max(0,...c.wt.map(w=>w[0]));partial=Math.abs(c.wt.reduce((a,w)=>a+w[1],0)-100)>1e-9;}
  const th=parseFloat(c.th)||0,cap=parseInt(c.cap)||0;
  return {exp,maxCycle:max*cap,ratio:th>0?exp/th*100:null,partial,
    issuable:c.budget>0?(exp>0?Math.floor(c.budget/exp):null):'unlimited'};
}
function costHtml(k,cur){

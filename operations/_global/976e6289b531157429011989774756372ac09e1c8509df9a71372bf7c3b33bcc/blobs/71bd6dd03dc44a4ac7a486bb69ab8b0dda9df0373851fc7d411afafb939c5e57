const DP={};
const CAL_SVG='<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="5" width="18" height="16" rx="2"/><line x1="3" y1="10" x2="21" y2="10"/><line x1="8" y1="3" x2="8" y2="7"/><line x1="16" y1="3" x2="16" y2="7"/></svg>';
function pad(n){return String(n).padStart(2,'0');}
function dpMount(el){
  const t=el.dataset.target;
  DP[t]={el,time:el.dataset.time==='1',ph:el.dataset.ph||'請選擇',y:NOW.getUTCFullYear(),m:NOW.getUTCMonth(),pick:null,h:'00',mi:'00'};
  el.innerHTML=`<input type="hidden" id="${t}"/><div class="date-input" onclick="dpToggle('${t}')"><span id="${t}-disp"></span>${CAL_SVG}</div><div class="date-dropdown" id="${t}-dd"></div>`;
  dpSet(t,'');
}
function dpSet(t,val){
  const d=DP[t];document.getElementById(t).value=val;
  document.getElementById(t+'-disp').innerHTML=val?val.replace('T',' '):`<span class="ph">${d.ph}</span>`;
  if(t.startsWith('m-'))clearErr('field-time');
}
function dpDisable(t,b){DP[t].el.classList.toggle('disabled',b);if(b)dpClose(t);}
function dpClose(t){document.getElementById(t+'-dd').classList.remove('open');}
function dpCloseAll(){Object.keys(DP).forEach(dpClose);}
function dpToggle(t){
  const d=DP[t];if(d.el.classList.contains('disabled'))return;
  const dd=document.getElementById(t+'-dd');const open=dd.classList.contains('open');
  dpCloseAll();if(open)return;
  const v=document.getElementById(t).value;
  if(v){d.y=+v.slice(0,4);d.m=+v.slice(5,7)-1;d.pick=v.slice(0,10);if(d.time){d.h=v.slice(11,13);d.mi=v.slice(14,16);}}
  else{d.y=NOW.getUTCFullYear();d.m=NOW.getUTCMonth();d.pick=null;d.h='00';d.mi=t==='m-end'?'59':'00';if(t==='m-end')d.h='23';}
  dpRender(t);dd.classList.add('open');
}
function dpNav(t,k){const d=DP[t];d.m+=k;if(d.m<0){d.m=11;d.y--;}if(d.m>11){d.m=0;d.y++;}dpRender(t);}
function dpPick(t,day){
  const d=DP[t];d.pick=`${d.y}-${pad(d.m+1)}-${pad(day)}`;
  if(!d.time){dpSet(t,d.pick);dpClose(t);return;}
  dpRender(t);
}
function dpApply(t){
  const d=DP[t];if(!d.pick){showToast('請先選擇日期');return;}
  d.h=document.getElementById(t+'-h').value;d.mi=document.getElementById(t+'-mi').value;
  dpSet(t,`${d.pick}T${d.h}:${d.mi}`);dpClose(t);
}
function dpClear(t){DP[t].pick=null;dpSet(t,'');dpClose(t);}
function dpRender(t){
  const d=DP[t];
  const first=new Date(Date.UTC(d.y,d.m,1)).getUTCDay(),days=new Date(Date.UTC(d.y,d.m+1,0)).getUTCDate(),prev=new Date(Date.UTC(d.y,d.m,0)).getUTCDate();
  const today=`${NOW.getUTCFullYear()}-${pad(NOW.getUTCMonth()+1)}-${pad(NOW.getUTCDate())}`;
  let h='';
  for(let i=0;i<first;i++)h+=`<div class="cal-day other">${prev-first+1+i}</div>`;
  for(let x=1;x<=days;x++){const key=`${d.y}-${pad(d.m+1)}-${pad(x)}`;
    h+=`<div class="cal-day${key===today?' today':''}${key===d.pick?' sel':''}" onclick="dpPick('${t}',${x})">${x}</div>`;}
  const rest=(7-(first+days)%7)%7;for(let x=1;x<=rest;x++)h+=`<div class="cal-day other">${x}</div>`;
  const opts=(n,cur)=>Array.from({length:n},(_,i)=>`<option${pad(i)===cur?' selected':''}>${pad(i)}</option>`).join('');
  document.getElementById(t+'-dd').innerHTML=`
    <div class="cal-head"><button class="cal-nav" onclick="dpNav('${t}',-1)">‹</button><span class="cal-month">${d.y} 年 ${d.m+1} 月</span><button class="cal-nav" onclick="dpNav('${t}',1)">›</button></div>
    <div class="cal-grid"><div class="cal-dow"><span>日</span><span>一</span><span>二</span><span>三</span><span>四</span><span>五</span><span>六</span></div><div class="cal-days">${h}</div></div>
    ${d.time?`<div class="cal-time">時間 (UTC+0)<select id="${t}-h">${opts(24,d.h)}</select>:<select id="${t}-mi">${opts(60,d.mi)}</select></div>`:''}
    <div class="cal-foot"><button class="btn-sm" onclick="dpClear('${t}')">清除</button>${d.time?`<button class="btn-sm btn-primary" onclick="dpApply('${t}')">確定</button>`:''}</div>`;
}
document.querySelectorAll('.dp').forEach(dpMount);
document.addEventListener('mousedown',e=>{if(!e.target.closest('.dp'))dpCloseAll();});

document.addEventListener('keydown',e=>{if(e.key==='Escape'){if(document.querySelector('.date-dropdown.open')){dpCloseAll();return;}closeAdd();closeDetail();closeCancel();closeBudget();}});
['add-overlay','detail-overlay','cancel-overlay','budget-overlay'].forEach(id=>document.getElementById(id).addEventListener('click',e=>{if(e.target===e.currentTarget)document.getElementById(id).classList.remove('active');}));

renderSidebar();renderHint();renderTabs();render();
</script>
</body>
</html>

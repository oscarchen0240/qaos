    const budgetCell=a.budget
      ?`<div class="num">${used.toLocaleString()} ／ ${a.budget.toLocaleString()}</div><div class="bar"><div class="bar-fill${used>=a.budget||a.exhausted?' full':''}" style="width:${Math.min(100,used/a.budget*100)}%"></div></div><div class="sub">剩餘 ${Math.max(0,a.budget-used).toLocaleString()} ${a.wallet}</div>`
      :'<div>不限</div>';
    return `<div class="rp-card"><div class="rp-row">
      <div><div style="display:flex;align-items:center;gap:6px;"><span class="rp-tag">紅包</span><span style="font-size:14px;font-weight:500;color:var(--text-primary);overflow:hidden;text-overflow:ellipsis;">${a.name}</span></div>
        <div class="sub">${SITES[a.site].machine?'':'參加等級：'+joinLevels(a)+'　'}${RESET_LABEL[a.reset]}</div></div>
      <div><div>${a.coins.join('、')}</div><div class="sub">派發 ${a.wallet}</div></div>

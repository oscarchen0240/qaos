function rewardText(p,cur){
  if(p.reward==='fixed')return `固定 ${p.fixed} ${cur}`;
  const amts=p.wt.map(w=>w[0]);
  return `隨機 ${Math.min(...amts)}～${Math.max(...amts)} ${cur}<div class="sub">權重表 ${p.wt.length} 項</div>`;
}
function rewardFull(p,cur){return p.reward==='fixed'?`固定金額 ${p.fixed} ${cur}`:'隨機：'+p.wt.map(w=>`${w[0]}（${w[1]}%）`).join('・');}
function render(){

<script>
const SITES={
  main:{name:'主站台（線上）',machine:false,core:'USDT',wallets:['USDT','EUR','USD']},
  ty:{name:'桃園場館（機台）',machine:true,core:'TWD',wallets:['TWD'],closing:'20:00'},
  tc:{name:'台中場館（機台）',machine:true,core:'TWD',wallets:['TWD'],closing:'16:00'},
};
// 6.2 會員等級設定「生效方案」的等級（示意）；紅包等級規則以 VIP 等級序號記錄
const LEVEL_NAMES={1:'Starter',2:'Bronze',3:'Silver',4:'Gold',5:'Platinum'};
const LEVELS=Object.keys(LEVEL_NAMES).map(Number);
const LEVEL_MEMBERS={1:1280,2:640,3:310,4:95,5:22};  // 6.2 等級列表「會員人數」（示意）
// 規則涵蓋的等級與會員人數：預設規則＝未被等級規則勾選的等級
function coveredLevels(p,list){return p.def?LEVELS.filter(l=>!list.some(q=>!q.def&&q.levels.includes(l))):p.levels.filter(l=>LEVELS.includes(l));}
function membersOf(p,list){return coveredLevels(p,list).reduce((a,l)=>a+(LEVEL_MEMBERS[l]||0),0);}
function lvLabel(n){return LEVEL_NAMES[n]?`${n}・${LEVEL_NAMES[n]}`:`${n}（目前方案無此等級）`;}
const ONLINE_TYPES=['每日簽到','累計簽到','儲值活動','熱門活動','彩金活動','紅包活動'];
const RESET_LABEL={day:'每日重置',week:'每週一重置',month:'每月 1 日重置',none:'不重置'};
const NOW=new Date('2026-09-24T08:00:00Z');

let nextId=1;
// 規則：levels 為 null 表示預設規則（套用其餘等級）；活動無預設規則＝預設規則關閉（其餘等級不參加）
const P=(levels,th,cap,reward,x,audit)=>({levels,th,cap,reward,fixed:reward==='fixed'?x:null,wt:reward==='random'?x:[],audit});
function mk(o){
  o.id=nextId++;
  o.plans.forEach(p=>{p.def=!p.levels;p.levels=p.levels||[];});
  let n=0;o.plans.forEach(p=>p.name=p.def?'預設規則':'等級規則 '+(++n));
  if(!SITES[o.site].machine)o.plans.forEach(p=>p.members=membersOf(p,o.plans));  // 建立當下涵蓋會員人數
  return o;
}
let activities=[
  mk({site:'main',name:'九月流水紅包',wallet:'USDT',coins:['USDT','EUR','USD'],budget:5000,reset:'day',forever:false,start:'2026-09-01T00:00',end:'2026-09-30T23:59',cancelled:false,
    plans:[P(null,1000,5,'random',[[8,60],[18,30],[88,10]],1),P([4,5],800,8,'random',[[18,60],[38,30],[188,10]],1)]}),
  mk({site:'main',name:'VIP 週末紅包',wallet:'USDT',coins:['USDT','EUR'],budget:3000,reset:'week',forever:false,start:'2026-10-01T00:00',end:'2026-10-31T23:59',cancelled:false,
    plans:[P([4],5000,3,'fixed',50,2),P([5],5000,3,'fixed',80,2)]}),
  mk({site:'main',name:'八月流水紅包',wallet:'USDT',coins:['USDT'],budget:null,reset:'day',forever:false,start:'2026-08-01T00:00',end:'2026-08-31T23:59',cancelled:false,
    plans:[P(null,1000,5,'fixed',10,1)]}),
  mk({site:'main',name:'七月測試紅包',wallet:'USDT',coins:['EUR'],budget:null,reset:'none',forever:false,start:'2026-07-01T00:00',end:'2026-07-31T23:59',cancelled:true,
    plans:[P([1],500,2,'fixed',5,1)]}),
  mk({site:'ty',name:'桃園機台好運紅包',wallet:'TWD',coins:['TWD'],budget:'used',exhausted:true,reset:'day',forever:true,start:'2026-09-10T00:00',end:'',cancelled:false,
    plans:[P(null,20000,10,'random',[[100,70],[300,25],[1000,5]],0)]}),
  mk({site:'ty',name:'桃園開幕紅包',wallet:'TWD',coins:['TWD'],budget:null,reset:'day',forever:false,start:'2026-08-15T00:00',end:'2026-08-31T23:59',cancelled:false,
    plans:[P(null,10000,5,'fixed',200,0)]}),
  mk({site:'tc',name:'台中九月週末紅包',wallet:'TWD',coins:['TWD'],budget:20000,reset:'week',forever:false,start:'2026-09-15T00:00',end:'2026-09-30T23:59',cancelled:false,
    plans:[P(null,15000,3,'fixed',150,0)]}),
  mk({site:'tc',name:'台中年終紅包',wallet:'TWD',coins:['TWD'],budget:50000,reset:'day',forever:false,start:'2026-12-01T00:00',end:'2026-12-31T23:59',cancelled:false,
    plans:[P(null,20000,8,'random',[[100,60],[300,30],[888,10]],1)]}),
  mk({site:'tc',name:'台中試營運紅包',wallet:'TWD',coins:['TWD'],budget:null,reset:'day',forever:false,start:'2026-08-01T00:00',end:'2026-08-31T23:59',cancelled:false,
    plans:[P(null,8000,5,'random',[[50,80],[200,20]],0)]}),
  mk({site:'tc',name:'台中測試紅包',wallet:'TWD',coins:['TWD'],budget:5000,reset:'none',forever:false,start:'2026-07-10T00:00',end:'2026-07-31T23:59',cancelled:true,
    plans:[P(null,5000,2,'fixed',100,0)]}),
];
// 會員當下適用的規則：該等級有等級規則則用之 → 否則預設規則（開啟時）→ 皆無則不參加（null）
function planFor(a,lv){
  if(SITES[a.site].machine)return a.plans.find(p=>p.def)||null;
  return a.plans.find(p=>!p.def&&p.levels.includes(lv))||a.plans.find(p=>p.def)||null;
}
// 參加等級摘要（列表與明細）
function joinLevels(a){
  if(SITES[a.site].machine)return '本場館所有機台帳號';
  if(a.plans.some(p=>p.def))return '全部等級';
  const lv=a.plans.flatMap(p=>p.levels);return lv.sort((x,y)=>x-y).map(lvLabel).join('、');
}
// 預設規則實際套用的等級
function defaultScope(a){
  if(SITES[a.site].machine)return '本場館所有機台帳號';
  const taken=a.plans.filter(p=>!p.def).flatMap(p=>p.levels);
  const rest=LEVELS.filter(l=>!taken.includes(l));
  return (rest.length?rest.map(lvLabel).join('、')+'，及其他未勾選的等級序號':'其他未勾選的等級序號');
}
// 示意會員等級序號；BBAA00706 於第 10 筆後由 3 升為 4（改用等級規則）
const MEM_LV={BBAA00701:2,BBAA00702:4,BBAA00703:1,BBAA00705:5,BBAA00706:3};
function memLevel(m,i){return m==='BBAA00706'&&i>=9?4:MEM_LV[m]||null;}

// 假紅包紀錄
const RECORDS={};
function seedRecords(a){
  const machine=SITES[a.site].machine;
  const pre=a.site==='tc'?'TCM':'TYM';
  const mems=machine?[1,2,3,4].map(n=>pre+String(n).padStart(5,'0')):['BBAA00701','BBAA00702','BBAA00703','BBAA00705','BBAA00706'];
  const out=[];let n=1;
  const base=new Date(a.start+':00Z');
  for(let i=0;i<14;i++){
    const m=mems[i%mems.length];
    const t=new Date(base.getTime()+i*5.3*3600*1000);
    if(t>NOW)break;
    const lv=machine?null:memLevel(m,i);
    const pl=planFor(a,lv);if(!pl)continue;
    const amt=pl.reward==='fixed'?pl.fixed:pickWt(pl.wt,i);
    const r=i%5;
    let st='credited',reason='—',cred='';
    if(r===3){st='void';reason=machine?(i%2?'機台出金':'機台洗分'):'週期重置';}
    else if(r===4&&i>8){st='pending';}
    else cred=fmt(new Date(t.getTime()+(machine?40:3600)*1000));
    out.push({no:'RP'+String(a.id).padStart(3,'0')+String(n++).padStart(5,'0'),mem:m,
      session:machine?'S'+m.slice(-3)+'-'+String(20+i).padStart(4,'0'):'—',
      plan:pl.name,lv,at:fmt(t),atDate:t,cum:pl.th*(1+(i%3)),amt,audit:pl.audit,st,cred:cred||'—',reason});
  }
  return out;
}
function pickWt(wt,i){const r=(i*37)%100;let acc=0;for(const [amt,p] of wt){acc+=p;if(r<acc)return amt;}return wt[0][0];}
function fmt(d){const p=n=>String(n).padStart(2,'0');return `${d.getUTCFullYear()}-${p(d.getUTCMonth()+1)}-${p(d.getUTCDate())} ${p(d.getUTCHours())}:${p(d.getUTCMinutes())}`;}
activities.forEach(a=>RECORDS[a.id]=seedRecords(a));
// 預算占用＝已入帳＋待開啟金額（作廢即釋放）
function usedOf(a){return (RECORDS[a.id]||[]).filter(r=>r.st!=='void').reduce((s,r)=>s+r.amt,0);}
activities.forEach(a=>{if(a.budget==='used')a.budget=usedOf(a);});  // 示意：桃園好運紅包的預算剛好用罄

let site='main',statusFilter='all',typeTab='紅包活動';

function isMachine(){return SITES[site].machine;}
// 日結時間為 UTC+0，換算台灣時間（UTC+8）供表單提示
function twTime(hm){const [h,m]=hm.split(':').map(Number);return `${String((h+8)%24).padStart(2,'0')}:${String(m).padStart(2,'0')}`;}
function getStatus(a){
  if(a.cancelled)return 'cancelled';
  const s=new Date(a.start+':00Z');
  if(s>NOW)return 'scheduled';
  if(!a.forever&&a.end&&new Date(a.end+':00Z')<NOW)return 'expired';
  return 'active';
}
const SL={active:'進行中',scheduled:'排程中',expired:'已結束',cancelled:'已取消'};


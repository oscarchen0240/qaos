    <div class="stat-mini"><div class="stat-mini-lbl">單個紅包期望金額${k.partial?'（機率未滿 100%，僅供參考）':''}</div><div class="stat-mini-val">${+k.exp.toFixed(2)} <span style="font-size:11px;color:var(--text-muted);">${cur}</span></div></div>
    <div class="stat-mini"><div class="stat-mini-lbl">每帳號單週期最高成本</div><div class="stat-mini-val">${+k.maxCycle.toFixed(2)} <span style="font-size:11px;color:var(--text-muted);">${cur}</span></div></div>
    <div class="stat-mini"><div class="stat-mini-lbl">成本占比（期望金額 ÷ 門檻）</div><div class="stat-mini-val">${k.ratio===null?'—':k.ratio.toFixed(2)+'%'}</div></div>
    <div class="stat-mini"><div class="stat-mini-lbl">預算約可發放（總預算 ÷ 期望金額）</div><div class="stat-mini-val">${k.issuable==='unlimited'?'不限':k.issuable===null?'—':k.issuable.toLocaleString()+' <span style="font-size:11px;color:var(--text-muted);">個</span>'}</div></div>`;
}
// 實際平均紅包金額＝該規則已入帳金額 ÷ 已入帳數（僅計已入帳），與該規則期望金額對照
function actualHtml(a,p){
  const cr=(RECORDS[a.id]||[]).filter(x=>x.st==='credited'&&x.plan===p.name);
  const exp=calcCost(p).exp;
  if(!cr.length)return `<div class="stat-mini"><div class="stat-mini-lbl">實際平均紅包金額</div><div class="stat-mini-val">—</div><div class="sub">尚無已入帳紅包</div></div>`;
  const avg=cr.reduce((s,x)=>s+x.amt,0)/cr.length;
  const diff=exp>0?(avg-exp)/exp*100:0;
  const col=Math.abs(diff)<0.005?'var(--text-secondary)':diff>0?'var(--red-text)':'var(--green-text)';
  return `<div class="stat-mini"><div class="stat-mini-lbl">實際平均紅包金額</div><div class="stat-mini-val">${+avg.toFixed(2)} <span style="font-size:11px;color:var(--text-muted);">${a.wallet}</span></div><div class="sub">已入帳 ${cr.length} 個；較期望 <span style="color:${col};">${diff>=0?'+':''}${diff.toFixed(1)}%</span></div></div>`;
}
function renderPlanCost(i){

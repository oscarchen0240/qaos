function clearErr(id){const el=document.getElementById(id);if(el)el.classList.remove('field-error');}
function overlaps(s1,e1,s2,e2){return s1<(e2||Infinity)&&s2<(e1||Infinity);}
function saveAdd(){
  const m=isMachine();let bad=false;
  ['field-coins','field-time','field-budget','field-name','plans-msg'].forEach(clearErr);
  const forever=document.querySelector('input[name=tm]:checked').value==='forever';
  const start=document.getElementById('m-start').value,end=document.getElementById('m-end').value;
  if(!start||(!forever&&!end)){setErr('field-time','請設定活動時間');bad=true;}
  else if(!forever&&new Date(end)<=new Date(start)){setErr('field-time','結束時間須晚於開始時間');bad=true;}
  // 逐規則驗證；預設規則關閉時略過，且至少須有一個等級規則
  const hide=defaultOff();
  if(hide&&plans.length<2){setErr('plans-msg');bad=true;}
  plans.forEach((p,i)=>{
    if(p.def&&hide)return;
    if(!p.def&&!p.levels.length){setErr(`pf-${i}-lv`);bad=true;}
    if(!(parseFloat(p.th)>0)){setErr(`pf-${i}-th`);bad=true;}
    const cap=Number(p.cap);if(!(p.cap!==''&&cap>0&&Number.isInteger(cap))){setErr(`pf-${i}-cap`);bad=true;}
    if(p.reward==='fixed'&&!(parseFloat(p.fixed)>0)){setErr(`pf-${i}-fixed`);bad=true;}
    if(p.reward==='random'){
      const s=p.wt.reduce((a,w)=>a+w[1],0);
      if(Math.abs(s-100)>1e-9||p.wt.some(w=>!(w[0]>0))){setErr(`pf-${i}-wt`);bad=true;}
    }
  });
  const coins=m?[SITES[site].core]:[...document.querySelectorAll('#coin-cbs input:checked')].map(x=>x.value);
  if(!coins.length){setErr('field-coins');bad=true;}
  const bRaw=document.getElementById('m-budget').value.trim();
  const budget=bRaw===''?null:parseFloat(bRaw);
  if(budget!==null&&!(budget>0)){setErr('field-budget');bad=true;}
  const name=document.getElementById('m-name').value.trim();
  if(!name){setErr('field-name');bad=true;}
  if(bad){showToast('請修正標示紅框的欄位');return;}
  const ns=new Date(start+':00Z').getTime(),ne=forever?null:new Date(end+':00Z').getTime();
  const clash=activities.find(a=>a.site===site&&!a.cancelled&&getStatus(a)!=='expired'&&
    overlaps(ns,ne,new Date(a.start+':00Z').getTime(),a.forever?null:new Date(a.end+':00Z').getTime()));
  if(clash){setErr('field-time','與「'+clash.name+'」的活動時間重疊：同一站台同一時間僅能有一個進行中的紅包活動');return;}
  const saved=plans.filter(p=>!(p.def&&hide)).map(p=>P(p.def?null:[...p.levels],parseFloat(p.th),Number(p.cap),p.reward,
    p.reward==='fixed'?parseFloat(p.fixed):p.wt.map(w=>[...w]),parseFloat(p.audit)||0));
  const a=mk({site,name,wallet:SITES[site].core,coins,budget,exhausted:false,
    reset:document.getElementById('m-reset').value,forever,start,end,cancelled:false,plans:saved});
  activities.unshift(a);RECORDS[a.id]=[];
  closeAdd();render();showToast('已建立紅包活動「'+name+'」（'+saved.length+' 個規則）');
}


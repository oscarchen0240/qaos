// 整體試算：各規則依涵蓋會員人數加權；每帳號單週期最高成本取最大值
function overallCost(items,budget){
  const ks=items.map(x=>({k:calcCost({...x.p,budget}),w:x.w}));
  const W=ks.reduce((a,x)=>a+x.w,0);
  const maxCycle=Math.max(0,...ks.map(x=>x.k.maxCycle));
  if(!W)return {exp:null,maxCycle,ratio:null,issuable:budget>0?null:'unlimited'};
  const exp=ks.reduce((a,x)=>a+x.k.exp*x.w,0)/W;
  const rs=ks.filter(x=>x.k.ratio!==null),RW=rs.reduce((a,x)=>a+x.w,0);
  return {exp,maxCycle,ratio:RW?rs.reduce((a,x)=>a+x.k.ratio*x.w,0)/RW:null,issuable:budget>0?(exp>0?Math.floor(budget/exp):null):'unlimited'};
}
function overallHtml(o,cur){
  const u=`<span style="font-size:11px;color:var(--text-muted);">${cur}</span>`;
  return `
    <div class="stat-mini"><div class="stat-mini-lbl">整體期望金額（依會員人數加權）</div><div class="stat-mini-val">${o.exp===null?'—':+o.exp.toFixed(2)+' '+u}</div></div>
    <div class="stat-mini"><div class="stat-mini-lbl">每帳號單週期最高成本（各規則最大值）</div><div class="stat-mini-val">${+o.maxCycle.toFixed(2)} ${u}</div></div>
    <div class="stat-mini"><div class="stat-mini-lbl">整體成本占比</div><div class="stat-mini-val">${o.ratio===null?'—':o.ratio.toFixed(2)+'%'}</div></div>
    <div class="stat-mini"><div class="stat-mini-lbl">預算約可發放（總預算 ÷ 整體期望金額）</div><div class="stat-mini-val">${o.issuable==='unlimited'?'不限':o.issuable===null?'—':o.issuable.toLocaleString()+' <span style="font-size:11px;color:var(--text-muted);">個</span>'}</div></div>`;
}

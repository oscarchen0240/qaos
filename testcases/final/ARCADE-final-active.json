  {
    "title": "鏈上錢包管理TWD頁籤可設定機台場館稽核倍數，預設0，修改後套用於開分/入金計算",
    "product": "ba-admin",
    "functional_area": "ARCADE",
    "requirement_ids": [
      "REQ-ARCADE-004"
    ],
    "acceptance_criteria_ids": [
      "AC-ARCADE-004"
    ],
    "spec_id": "SPEC-ARCADE-001",
    "spec_version": "0.7",
    "test_level": "ui_e2e",
    "test_types": [
      "functional"
    ],
    "design_techniques": [
      "requirement_based"
    ],
    "priority": "high",
    "risk": "high",
    "execution_mode": "manual",
    "preconditions": [
      "以 Admin 登入後台，站台切換至一個機台場館"
    ],
    "test_data": [],
    "steps": [
      {
        "n": 1,
        "action": "至鏈上錢包管理 > TWD 頁籤，確認稽核倍數欄位預設值為 0"
      },
      {
        "n": 2,
        "action": "修改稽核倍數為大於 0 的值（例如 3）並儲存"
      },
      {
        "n": 3,
        "action": "對該機台場館的一個機台帳號執行一筆開分或入金"
      },
      {
        "n": 4,
        "action": "檢視稽核明細，確認該筆交易確實依新設定的倍數計算出稽核門檻，而非沿用舊倍數或不計算"
      }
    ],
    "expected_result": "可見稽核倍數設定欄位，預設值顯示為 0；修改數值並儲存後，該倍數即套用於後續的機台開分與入金計算——稽核明細顯示的計算結果反映新倍數，不是單純存檔留存而已",
    "expected_result_spec_reference": {
      "spec_id": "SPEC-ARCADE-001",
      "spec_version": "0.7",
      "location": "機台帳號的稽核／設定位置",
      "quote": "設定位置｜鏈上錢包管理，於 TWD 頁籤設定稽核倍數；預設值｜0 倍；倍數大於 0 時｜洗分與出金的核可金額須扣除尚未完成稽核的部分"
    },

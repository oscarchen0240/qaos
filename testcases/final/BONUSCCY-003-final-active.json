  {
    "title": "達標玩家開啟一次前台簽到頁即直接寫入有效會員，後台不需玩家再存一筆即同步",
    "product": "ba-admin",
    "functional_area": "BONUSCCY",
    "requirement_ids": [
      "REQ-BONUSCCY-013"
    ],
    "acceptance_criteria_ids": [
      "AC-BONUSCCY-020"
    ],
    "spec_id": "SPEC-BONUSCCY-003",
    "spec_version": "1.0",
    "test_level": "ui_e2e",
